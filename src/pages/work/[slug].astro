---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { workPages, type Project } from '../../data/projects';

export function getStaticPaths() {
  return workPages.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const placeholder = '{{заполнить}}';
---

<BaseLayout title={`${project.title} — портфолио`} description={project.summary}>
  <article class="case">
    <header
      class="case__cover"
      style={`background-image: url(${project.cover})`}
      transition:name={`work-cover-${project.slug}`}
    >
      <div class="case__cover-shade page-pad">
        <p class="eyebrow mono">{project.year} · {project.stack}</p>
        <h1 class="case__title">{project.title}</h1>
      </div>
    </header>

    <div class="case__body page-pad">
      <p class="case__lead">{project.summary}</p>
      <p class="case__text">{placeholder}</p>
      <div class="case__actions">
        <Button href="/" variant="ghost">На главную</Button>
        <Button href="/#work" variant="primary">Все проекты</Button>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .case__cover {
    min-height: clamp(18rem, 52vh, 34rem);
    display: grid;
    align-items: end;
    background-position: center;
    background-size: cover;
    border-bottom: var(--stroke) solid var(--border);
  }

  .case__cover-shade {
    padding-block: var(--space-8) var(--space-7);
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--bg) 92%, transparent),
      color-mix(in srgb, var(--bg) 20%, transparent) 55%,
      transparent
    );
  }

  .case__title {
    margin: var(--space-3) 0 0;
    max-width: 12ch;
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .case__body {
    width: min(100%, 46rem);
    margin-inline: auto;
    padding-block: var(--space-7) var(--section-gap);
    display: grid;
    gap: var(--space-5);
  }

  .case__lead,
  .case__text {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--text-md);
  }

  .case__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }
</style>
