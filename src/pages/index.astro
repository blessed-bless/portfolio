---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import BusinessOffers from '../components/BusinessOffers.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import {
  homeServiceOffersRu,
  personJsonLd,
  serviceOfferJsonLd,
  webSiteJsonLd,
} from '../lib/jsonld';
import { ui } from '../i18n';

const t = ui('ru');

const jsonLd = [
  webSiteJsonLd('ru'),
  {
    '@context': 'https://schema.org',
    ...personJsonLd('ru'),
  },
  ...homeServiceOffersRu.map((offer) => serviceOfferJsonLd('ru', offer)),
];
---

<BaseLayout
  title={t.home.title}
  description={t.home.description}
  canonicalPath="/"
  ogImage="/og/home.png"
  jsonLd={jsonLd}
>
  <Hero />
  <FeaturedWork />
  <BusinessOffers />
  <Faq />
  <Contact />
</BaseLayout>
