---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import BusinessOffers from '../components/BusinessOffers.astro';
import WhoAmI from '../components/WhoAmI.astro';
import Faq from '../components/Faq.astro';
import StackMarquee from '../components/StackMarquee.astro';
import ChannelFeed from '../components/ChannelFeed.astro';
import Contact from '../components/Contact.astro';
import {
  homeServiceOffersRu,
  personJsonLd,
  serviceOfferJsonLd,
  webSiteJsonLd,
} from '../lib/jsonld';
import { ui } from '../i18n';

const t = ui('ru');

const jsonLd = [
  webSiteJsonLd('ru'),
  {
    '@context': 'https://schema.org',
    ...personJsonLd('ru'),
  },
  ...homeServiceOffersRu.map((offer) => serviceOfferJsonLd('ru', offer)),
];
---

<BaseLayout
  title={t.home.title}
  description={t.home.description}
  canonicalPath="/"
  ogImage="/og/home.png"
  jsonLd={jsonLd}
>
  <Hero />
  <BusinessOffers />
  <WhoAmI />
  <FeaturedWork />
  <StackMarquee />
  <ChannelFeed />
  <Faq />
  <Contact />
</BaseLayout>

<script>
  let offers: HTMLElement | null = null;
  let observer: IntersectionObserver | null = null;
  let unmountHomePage: (() => void) | null = null;

  function scheduleHome(): void {
    const root = document.querySelector<HTMLElement>('[data-offers]');
    if (!root || root === offers) return;
    offers = root;

    observer = new IntersectionObserver(async ([entry]) => {
      if (!entry?.isIntersecting) return;
      observer?.disconnect();
      const home = await import('../scripts/home-page');
      if (offers !== root) return;
      home.mountHomePage();
      unmountHomePage = home.unmountHomePage;
    }, { rootMargin: '0px 0px -10% 0px' });
    observer.observe(root);
  }

  scheduleHome();
  document.addEventListener('astro:page-load', scheduleHome);
  document.addEventListener('astro:before-swap', () => {
    observer?.disconnect();
    observer = null;
    offers = null;
    unmountHomePage?.();
    unmountHomePage = null;
  });
</script>
