---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Manifest from '../components/Manifest.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import Services from '../components/Services.astro';
import StackMarquee from '../components/StackMarquee.astro';
import Contact from '../components/Contact.astro';
import {
  defaultDescription,
  personJobTitle,
  personName,
  siteUrl,
} from '../lib/site';
import { isFilled } from '../lib/fill';
import { contactLinks } from '../data/home';

const sameAs = [contactLinks.github, contactLinks.telegram].filter(isFilled);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: personName,
  jobTitle: personJobTitle,
  url: siteUrl,
  ...(sameAs.length ? { sameAs } : {}),
};
---

<BaseLayout
  title="Богдан — портфолио"
  description={defaultDescription}
  canonicalPath="/"
  ogImage="/og/home.svg"
  jsonLd={personLd}
>
  <Hero />
  <Manifest />
  <FeaturedWork />
  <Services />
  <StackMarquee />
  <Contact />
</BaseLayout>

<script>
  let manifest: HTMLElement | null = null;
  let observer: IntersectionObserver | null = null;
  let unmountHomePage: (() => void) | null = null;

  function scheduleHome(): void {
    const root = document.querySelector<HTMLElement>('[data-manifest]');
    if (!root || root === manifest) return;
    manifest = root;

    observer = new IntersectionObserver(async ([entry]) => {
      if (!entry?.isIntersecting) return;
      observer?.disconnect();
      const home = await import('../scripts/home-page');
      if (manifest !== root) return;
      home.mountHomePage();
      unmountHomePage = home.unmountHomePage;
    }, { rootMargin: '0px 0px -10% 0px' });
    observer.observe(root);
  }

  scheduleHome();
  document.addEventListener('astro:page-load', scheduleHome);
  document.addEventListener('astro:before-swap', () => {
    observer?.disconnect();
    observer = null;
    manifest = null;
    unmountHomePage?.();
    unmountHomePage = null;
  });
</script>
