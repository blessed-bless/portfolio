---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SmenaPreview from '../../components/SmenaPreview.astro';
import WorkRows from '../../components/WorkRows.astro';
import BusinessOffers from '../../components/BusinessOffers.astro';
import DevQueue from '../../components/DevQueue.astro';
import Who from '../../components/Who.astro';
import ChannelStrip from '../../components/ChannelStrip.astro';
import Contact from '../../components/Contact.astro';
import { fetchChannelPosts } from '../../lib/telegram-channel';
import { personJsonLd, webSiteJsonLd } from '../../lib/jsonld';
import { ui } from '../../i18n';

const t = ui('en');
const posts = (await fetchChannelPosts(3)).filter((post) => !/[\u0400-\u04FF]/.test(post.text));

const jsonLd = [
  webSiteJsonLd('en'),
  {
    '@context': 'https://schema.org',
    ...personJsonLd('en'),
  },
];
---

<BaseLayout
  title={t.home.title}
  description={t.home.description}
  canonicalPath="/en/"
  ogImage="/og/en/home.png"
  jsonLd={jsonLd}
>
  <div data-home-root>
    <Hero />
    <SmenaPreview />
    <WorkRows />
    <BusinessOffers />
    <DevQueue />
    <Who />
    {posts.length ? <ChannelStrip posts={posts} /> : null}
    <Contact />
  </div>
</BaseLayout>
