---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import WorkRows from '../../components/WorkRows.astro';
import BusinessOffers from '../../components/BusinessOffers.astro';
import Stats from '../../components/Stats.astro';
import Who from '../../components/Who.astro';
import StackGrid from '../../components/StackGrid.astro';
import Faq from '../../components/Faq.astro';
import Contact from '../../components/Contact.astro';
import { serviceOffers } from '../../data/order';
import { getProjects } from '../../lib/work';
import {
  homeServiceOffersEn,
  personJsonLd,
  serviceOfferJsonLd,
  webSiteJsonLd,
} from '../../lib/jsonld';
import { ui } from '../../i18n';

const t = ui('en');
const projects = await getProjects('en');
const demoCount = projects.filter((project) => project.links.demo || project.links.live || project.links.bot).length;

const jsonLd = [
  webSiteJsonLd('en'),
  {
    '@context': 'https://schema.org',
    ...personJsonLd('en'),
  },
  ...homeServiceOffersEn.map((offer) => serviceOfferJsonLd('en', offer)),
];
---

<BaseLayout
  title={t.home.title}
  description={t.home.description}
  canonicalPath="/en/"
  ogImage="/og/en/home.png"
  jsonLd={jsonLd}
>
  <div data-home-root>
    <Hero />
    <WorkRows />
    <BusinessOffers />
    <Stats cases={projects.length} demos={demoCount} services={serviceOffers('en').length + 1} />
    <Who />
    <StackGrid />
    <Faq />
    <Contact />
  </div>
</BaseLayout>
