---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import FeaturedWork from '../../components/FeaturedWork.astro';
import BusinessOffers from '../../components/BusinessOffers.astro';
import Faq from '../../components/Faq.astro';
import Contact from '../../components/Contact.astro';
import {
  homeServiceOffersEn,
  personJsonLd,
  serviceOfferJsonLd,
  webSiteJsonLd,
} from '../../lib/jsonld';
import { ui } from '../../i18n';

const t = ui('en');

const jsonLd = [
  webSiteJsonLd('en'),
  {
    '@context': 'https://schema.org',
    ...personJsonLd('en'),
  },
  ...homeServiceOffersEn.map((offer) => serviceOfferJsonLd('en', offer)),
];
---

<BaseLayout
  title={t.home.title}
  description={t.home.description}
  canonicalPath="/en/"
  ogImage="/og/en/home.png"
  jsonLd={jsonLd}
>
  <Hero />
  <FeaturedWork />
  <BusinessOffers />
  <Faq />
  <Contact />
</BaseLayout>
