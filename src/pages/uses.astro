---
import BaseLayout from '../layouts/BaseLayout.astro';
import { filledUsesGroups } from '../data/uses';
import { ui } from '../i18n';

const t = ui('ru');
const groups = filledUsesGroups('ru');
---

<BaseLayout
  title={t.uses.title}
  description={t.uses.description}
  canonicalPath="/uses/"
  ogImage="/og/home.png"
>
  <article class="uses page-pad">
    <header class="uses__hero">
      <p class="eyebrow">{t.uses.eyebrow}</p>
      <h1 class="uses__title" data-page-title>{t.uses.heading}</h1>
      <p class="uses__lead">{t.uses.lead}</p>
    </header>

    {
      groups.length > 0 ? (
        <div class="uses__grid">
          {groups.map((group) => (
            <section class="uses__block">
              <h2 class="uses__h2">{group.title}</h2>
              <ul class="uses__list">
                {group.items.map((item) => (
                  <li>
                    <span class="mono uses__label">{item.label}</span>
                    <span class="uses__value">{item.value}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <p class="uses__empty">{t.uses.empty}</p>
      )
    }
  </article>
</BaseLayout>

<style>
  .uses {
    padding-block: var(--space-8) var(--space-10);
  }

  .uses__hero {
    max-width: 40rem;
    margin-bottom: var(--space-8);
  }

  .uses__title {
    margin: var(--space-3) 0 0;
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    letter-spacing: var(--tracking-tight);
  }

  .uses__lead {
    margin: var(--space-4) 0 0;
    color: var(--fg-muted);
    line-height: var(--leading-body);
  }

  .uses__grid {
    display: grid;
    gap: var(--space-8);
  }

  .uses__h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-lg);
  }

  .uses__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }

  .uses__list li {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) minmax(0, 1fr);
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: var(--stroke) solid var(--border);
  }

  .uses__label {
    font-size: var(--text-xs);
    color: var(--fg-muted);
    text-transform: uppercase;
  }

  .uses__value {
    font-size: var(--text-sm);
  }

  .uses__empty {
    color: var(--fg-muted);
  }

  @media (max-width: 640px) {
    .uses__list li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
