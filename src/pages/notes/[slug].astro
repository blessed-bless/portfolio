---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Diagram from '../../components/mdx/Diagram.astro';
import Figure from '../../components/mdx/Figure.astro';
import Button from '../../components/Button.astro';
import {
  getPublishedNotes,
  noteSlug,
  readingMinutes,
  renderNote,
} from '../../lib/notes';
import { siteName } from '../../lib/site';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  return notes.map((entry) => ({
    params: { slug: noteSlug(entry) },
  }));
}

const slug = Astro.params.slug;
if (!slug) {
  return Astro.redirect('/404');
}

const notes = await getPublishedNotes();
const entry = notes.find((note) => noteSlug(note) === slug);
if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await renderNote(entry);
const minutes = readingMinutes(typeof entry.body === 'string' ? entry.body : entry.data.description);
---

<BaseLayout
  title={`${entry.data.title} — ${siteName}`}
  description={entry.data.description}
  canonicalPath={`/notes/${slug}`}
  ogImage="/og/home.svg"
  printCase={true}
>
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>

  <article class="note" data-case>
    <header class="note__head page-pad">
      <p class="eyebrow mono">Заметка</p>
      <h1 class="note__title">{entry.data.title}</h1>
      <p class="note__meta mono">
        <time datetime={entry.data.pubDate.toISOString()}>
          {
            entry.data.pubDate.toLocaleDateString('ru-RU', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </time>
        <span aria-hidden="true">·</span>
        <span>{minutes} мин чтения</span>
      </p>
      <p class="note__desc">{entry.data.description}</p>
    </header>

    <div class="case__body page-pad" data-case-body>
      <Content components={{ Diagram, Figure }} />
    </div>

    <div class="note__actions page-pad">
      <Button href="/notes" variant="ghost">Все заметки</Button>
      <Button href="/" variant="primary">На главную</Button>
    </div>
  </article>
</BaseLayout>

<script>
  import { mountCodeCopy, mountReadingProgress } from '../../scripts/work-case';

  let cleanups: Array<() => void> = [];

  const boot = () => {
    cleanups.forEach((fn) => fn());
    cleanups = [];
    const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
    const body = document.querySelector<HTMLElement>('[data-case-body]');
    if (bar) cleanups.push(mountReadingProgress(bar));
    if (body) cleanups.push(mountCodeCopy(body));
  };

  boot();
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => {
    cleanups.forEach((fn) => fn());
    cleanups = [];
  });
</script>

<style>
  .note {
    padding-bottom: var(--section-gap);
  }

  .note__head {
    padding-top: var(--space-8);
    max-width: 46rem;
    margin-inline: auto;
  }

  .note__title {
    margin: var(--space-3) 0 0;
    font-size: clamp(2.2rem, 1.3rem + 3.5vw, 3.8rem);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .note__meta {
    margin: var(--space-4) 0 0;
    display: inline-flex;
    gap: var(--space-2);
    color: var(--fg-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .note__desc {
    margin: var(--space-4) 0 0;
    color: var(--fg-muted);
    font-size: var(--text-md);
  }

  .note__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    width: min(100%, 46rem);
    margin-inline: auto;
    padding-top: var(--space-6);
  }
</style>

<style is:global>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: 100%;
    height: 2px;
    transform: scaleX(0);
    transform-origin: left center;
    background: var(--accent-strong);
    pointer-events: none;
  }

  .case__body {
    width: min(100%, 46rem);
    margin-inline: auto;
    padding-block: var(--space-6) var(--space-8);
    display: grid;
    gap: var(--space-4);
    font-size: var(--text-md);
    line-height: var(--leading-body);
  }

  .case__body h2 {
    margin: var(--space-6) 0 var(--space-3);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
  }

  .case__body p,
  .case__body ul {
    margin: 0;
    color: color-mix(in srgb, var(--fg) 92%, var(--fg-muted));
  }

  .case__body ul {
    padding-left: 1.2rem;
    display: grid;
    gap: var(--space-2);
  }

  .case__body pre {
    margin: 0;
    padding: var(--space-5);
    overflow-x: auto;
    border: var(--stroke) solid var(--border);
    background: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.55;
  }
</style>
