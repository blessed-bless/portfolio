---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Страница не найдена — Богдан" description="Такой страницы нет" hasEnAlternate={false}>
  <section class="not-found page-pad">
    <p class="eyebrow mono">404</p>
    <h1 class="not-found__title">Здесь пусто</h1>
    <p class="not-found__text">Адрес не совпал ни с одной страницей. Вернись на главную или в работы.</p>
    <div class="not-found__actions">
      <Button href="/" variant="primary">На главную</Button>
      <Button href="/work/" variant="ghost">Работы</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100svh - var(--header-h));
    display: grid;
    align-content: center;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }

  .not-found__title {
    margin: 0;
    max-width: 10ch;
    font-size: clamp(3rem, 2rem + 6vw, 7rem);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }

  .not-found__text {
    margin: 0;
    max-width: 34ch;
    color: var(--fg-muted);
    font-size: var(--text-md);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
</style>
