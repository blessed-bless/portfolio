---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Страница не найдена — Богдан"
  description="Такой страницы нет"
  noindex={true}
  omitCanonical={true}
  hasEnAlternate={false}
>
  <section class="not-found page-pad">
    <div class="not-found__mark" data-liquid-metal-404 aria-hidden="true">
      <div class="not-found__mark-host" data-liquid-metal-host></div>
      <span class="not-found__mark-fallback" data-liquid-metal-fallback>
        <BrandMark size={160} />
      </span>
    </div>
    <p class="eyebrow mono">404</p>
    <h1 class="not-found__title">Здесь пусто</h1>
    <p class="not-found__text">Адрес не совпал ни с одной страницей. Вернись на главную или в работы.</p>
    <p class="not-found__text not-found__text--en" lang="en">No page here. Head home or browse the work.</p>
    <div class="not-found__actions">
      <Button href="/" variant="primary">На главную</Button>
      <Button href="/work/" variant="ghost">Работы</Button>
      <button type="button" class="not-found__play" data-orbit-open data-cursor="play">Покрутить</button>
    </div>
  </section>
</BaseLayout>

<script>
  let disposeMark: (() => void) | null = null;
  let bootToken = 0;

  async function bootLiquidMetal(): Promise<void> {
    const token = ++bootToken;
    disposeMark?.();
    disposeMark = null;

    const root = document.querySelector<HTMLElement>('[data-liquid-metal-404]');
    if (!root) return;

    const { mountLiquidMetal404 } = await import('../scripts/liquid-metal-404');
    if (token !== bootToken) return;

    const handle = await mountLiquidMetal404(root);
    if (token !== bootToken) {
      handle?.dispose();
      return;
    }
    disposeMark = handle ? () => handle.dispose() : null;
  }

  function bindToy(): void {
    const play = document.querySelector<HTMLButtonElement>('[data-orbit-open]');
    if (!play || play.dataset.bound === 'true') return;
    play.dataset.bound = 'true';
    play.addEventListener('click', () => {
      void import('../scripts/orbit-toy').then(({ openOrbitToy }) => openOrbitToy());
    });
  }

  document.addEventListener('astro:page-load', () => {
    void bootLiquidMetal();
    bindToy();
  });
  document.addEventListener('astro:before-swap', () => {
    bootToken += 1;
    disposeMark?.();
    disposeMark = null;
  });
</script>

<style>
  .not-found {
    min-height: calc(100svh - var(--header-h));
    display: grid;
    align-content: center;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }

  .not-found__mark {
    position: relative;
    width: 160px;
    height: 160px;
  }

  .not-found__mark-host {
    position: absolute;
    inset: 0;
    width: 160px;
    height: 160px;
    pointer-events: none;
  }

  .not-found__mark-fallback {
    display: block;
    width: 160px;
    height: 160px;
    color: var(--fg);
  }

  .not-found__mark-fallback :global(.brand-mark) {
    display: block;
    width: 160px;
    height: 160px;
  }

  .not-found__title {
    margin: 0;
    max-width: 10ch;
    font-size: clamp(3rem, 2rem + 6vw, 7rem);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }

  .not-found__text {
    margin: 0;
    max-width: 34ch;
    color: var(--fg-muted);
    font-size: var(--text-md);
  }

  .not-found__text--en {
    font-size: var(--text-sm);
    color: var(--fg-faint);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .not-found__play {
    min-height: 44px;
    padding: 0 1rem;
    border: var(--stroke) solid var(--border-strong);
    background: transparent;
    color: var(--fg);
    font: inherit;
    cursor: pointer;
  }
</style>
