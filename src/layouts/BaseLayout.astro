---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieNotice from '../components/CookieNotice.astro';
import SiteCursor from '../components/SiteCursor.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { contactLinks } from '../data/home';
import { defaultDescription, siteName, siteNameEn, siteUrl } from '../lib/site';
import { isFilled } from '../lib/fill';
import { hasPublishedNotes } from '../lib/notes';
import { withTrailingSlash } from '../lib/paths';
import { defaultLocale, isLocale, localizedPath, stripLocalePrefix, ui, type Locale } from '../i18n';
import onestWoff2 from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import onestLatinWoff2 from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Skip canonical, hreflang, og:url — for shared error HTML served on any bad path. */
  omitCanonical?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  printCase?: boolean;
  /** When the EN page has no twin, omit hreflang en. */
  hasEnAlternate?: boolean;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = '/og/home.png',
  noindex = false,
  omitCanonical = false,
  jsonLd,
  printCase = false,
  hasEnAlternate = true,
} = Astro.props;

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
const barePath = stripLocalePrefix(withTrailingSlash(canonicalPath));
const showNotesRss = locale === 'ru' && (await hasPublishedNotes());
const resolvedDescription = isFilled(description) ? description : defaultDescription;
const resolvedSiteName = locale === 'en' ? siteNameEn : siteName;
const canonical = new URL(withTrailingSlash(canonicalPath), siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ruHref = new URL(localizedPath('ru', barePath), siteUrl).href;
const enHref = new URL(localizedPath('en', barePath), siteUrl).href;
const ogLocale = locale === 'en' ? 'en_US' : 'ru_RU';
const telegram = isFilled(contactLinks.telegram) ? contactLinks.telegram : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={resolvedDescription} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0d0b12" data-theme-color />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    {!omitCanonical ? <link rel="canonical" href={canonical} /> : null}
    {!omitCanonical ? <link rel="alternate" hreflang="ru" href={ruHref} /> : null}
    {!omitCanonical && hasEnAlternate ? (
      <link rel="alternate" hreflang="en" href={enHref} />
    ) : null}
    {!omitCanonical ? <link rel="alternate" hreflang="x-default" href={ruHref} /> : null}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={resolvedSiteName} />
    <meta property="og:locale" content={ogLocale} />
    {hasEnAlternate ? (
      <meta property="og:locale:alternate" content={locale === 'en' ? 'ru_RU' : 'en_US'} />
    ) : null}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    {!omitCanonical ? <meta property="og:url" content={canonical} /> : null}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link type="text/plain" rel="author" href="/humans.txt" />
    {showNotesRss ? (
      <link rel="alternate" type="application/rss+xml" title="Заметки" href="/rss.xml" />
    ) : null}
    <link rel="preload" href={locale === 'en' ? onestLatinWoff2 : onestWoff2} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        const themeColors = { dark: '#0d0b12', light: '#f4f0fa' };
        const paintThemeColor = (mode) => {
          const el = document.querySelector('[data-theme-color]');
          if (el) el.setAttribute('content', themeColors[mode] || themeColors.dark);
        };
        try {
          const key = 'portfolio-theme';
          const stored = localStorage.getItem(key);
          const mode = stored === 'light' || stored === 'dark' ? stored : 'dark';
          document.documentElement.dataset.theme = mode;
          document.documentElement.style.colorScheme = mode;
          paintThemeColor(mode);
        } catch (_) {
          document.documentElement.dataset.theme = 'dark';
          paintThemeColor('dark');
        }

        // Early data-perf stamp (before paint) — refined by perf.ts after boot.
        try {
          const params = new URLSearchParams(location.search);
          const q = params.get('perf');
          if (q === 'low' || q === 'mid' || q === 'high') {
            document.documentElement.dataset.perf = q;
            sessionStorage.setItem('portfolio-perf-force', q);
            return;
          }
          if (localStorage.getItem('portfolio-less-motion') === '1') {
            document.documentElement.dataset.perf = 'low';
            return;
          }
          const forced = sessionStorage.getItem('portfolio-perf-force');
          if (forced === 'low' || forced === 'mid' || forced === 'high') {
            document.documentElement.dataset.perf = forced;
            return;
          }
          const floor = sessionStorage.getItem('portfolio-perf-floor');
          if (floor === 'low' || floor === 'mid' || floor === 'high') {
            document.documentElement.dataset.perf = floor;
            return;
          }
          const nav = navigator;
          const mem = nav.deviceMemory;
          const cores = nav.hardwareConcurrency || 8;
          const mobile = /Android|iPhone|iPad|iPod|Mobile/i.test(nav.userAgent);
          const saveData = Boolean(nav.connection && nav.connection.saveData);
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          let tier = 'high';
          if (reduce || saveData || (typeof mem === 'number' && mem <= 2) || (mobile && cores <= 4)) {
            tier = 'low';
          } else if (mobile || (typeof mem === 'number' && mem <= 4)) {
            tier = 'mid';
          }
          document.documentElement.dataset.perf = tier;
        } catch (_) {
          document.documentElement.dataset.perf = 'high';
        }
      })();
    </script>
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body class:list={[{ 'print-case': printCase }]}>
    <div id="vt-wipe" data-vt-wipe aria-hidden="true"></div>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <SiteCursor />
    <CommandPalette />
    <div class="site-shell">
      <Header />
      <main class="site-main" id="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    {
      telegram ? (
        <a class="sticky-discuss" href={telegram} data-telegram-handoff data-cursor="hover">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="currentColor" d="M21.5 4.4 2.7 11.6c-.8.3-.8.8-.1 1l4.8 1.5 1.9 5.8c.2.6.1.9.8.9.4 0 .6-.2.9-.4l2.6-2.5 4.8 3.5c.8.5 1.4.2 1.6-.8l3-14.7c.3-1.3-.5-1.9-1.5-1.5Zm-12 9.2 8.8-5.5c.4-.3.8-.1.5.2l-7.6 6.9-.3 3.2-1.4-4.8Z" />
          </svg>
          <span>{t.header.discuss}</span>
        </a>
      ) : null
    }
    <CookieNotice />
    <script>
      import '../scripts/boot';
    </script>
  </body>
</html>
