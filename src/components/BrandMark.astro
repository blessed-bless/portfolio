---
interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;
---

<svg
  class:list={['brand-mark', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 512 512"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <path
    class="brand-mark__body"
    d="M156 112 L156 372 L222 314 L362 314 Z"
    fill="currentColor"
    stroke="currentColor"
    stroke-width="28"
    stroke-linejoin="round"></path>
  <rect class="brand-mark__caret" x="292" y="358" width="92" height="42" rx="8" fill="var(--accent)"></rect>
</svg>
