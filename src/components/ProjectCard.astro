---
interface Props {
  title: string;
  summary: string;
  meta: string;
  href?: string;
  year?: string;
}

const {
  title,
  summary,
  meta,
  href = '#',
  year = '{{заполнить}}',
} = Astro.props;
---

<a class="project-card" href={href} data-cursor="hover">
  <div class="project-card__meta mono">
    <span>{meta}</span>
    <span>{year}</span>
  </div>
  <h3 class="project-card__title">{title}</h3>
  <p class="project-card__summary">{summary}</p>
  <span class="project-card__more mono">Смотреть проект</span>
</a>

<style>
  .project-card {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: var(--stroke) solid var(--border);
    background: var(--bg-elevated);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--dur-2) var(--ease-out),
      background var(--dur-2) var(--ease-out),
      transform var(--dur-3) var(--ease-out);
  }

  .project-card:hover {
    border-color: var(--border-strong);
    background: var(--bg-soft);
    color: inherit;
    transform: translateY(-2px);
  }

  .project-card__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    text-transform: uppercase;
  }

  .project-card__title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .project-card__summary {
    margin: 0;
    max-width: 36ch;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .project-card__more {
    font-size: var(--text-xs);
    color: var(--accent-strong);
    text-transform: uppercase;
  }
</style>
