---
import { services } from '../data/home';
---

<section class="services" id="services" data-services aria-label="Что делаю">
  <div class="services__intro page-pad">
    <p class="eyebrow">Практика</p>
    <h2 class="services__title">Что делаю</h2>
  </div>

  <div class="services__viewport">
    <div class="services__track" data-services-track>
      {
        services.map((item, index) => (
          <article class="services__card">
            <p class="services__num mono">{String(index + 1).padStart(2, '0')}</p>
            <h3 class="services__card-title">{item.title}</h3>
            <p class="services__card-text">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: var(--section-gap) 0;
    border-top: var(--stroke) solid var(--border);
    overflow: hidden;
  }

  .services__intro {
    margin-bottom: var(--space-6);
  }

  .services__title {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .services__viewport {
    width: 100%;
  }

  .services__track {
    display: flex;
    gap: var(--grid-gutter);
    width: max-content;
    padding-inline: var(--page-pad);
    padding-bottom: var(--section-gap);
  }

  .services__card {
    flex: 0 0 min(30rem, 78vw);
    min-height: 20rem;
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-6) var(--space-6) var(--space-5);
    border: 0;
    border-left: var(--stroke) solid var(--border-strong);
    background: transparent;
  }

  .services__card:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .services__num {
    margin: 0;
    color: var(--accent-strong);
    font-size: var(--text-sm);
  }

  .services__card-title {
    margin: 0;
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .services__card-text {
    margin: 0;
    max-width: 28ch;
    color: var(--fg-muted);
    font-size: var(--text-md);
  }

  @media (max-width: 900px) {
    .services__track {
      display: grid;
      width: 100%;
      gap: var(--space-4);
      padding-inline: var(--page-pad);
      transform: none !important;
    }

    .services__card {
      flex: none;
      width: 100%;
      min-height: 0;
      padding: var(--space-5) 0;
      border-left: 0;
      border-top: var(--stroke) solid var(--border-strong);
    }

    .services__card:first-child {
      padding-left: 0;
    }
  }
</style>
