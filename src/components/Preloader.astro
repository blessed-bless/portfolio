<div class="preloader" data-preloader hidden data-state="enter" aria-hidden="true">
  <div class="preloader__bar"></div>
  <p class="preloader__label mono">Загрузка</p>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-content: center;
    gap: var(--space-4);
    background: var(--bg);
    transition: opacity 320ms var(--ease-out), visibility 320ms;
  }

  .preloader[data-state='leave'] {
    opacity: 0;
    visibility: hidden;
  }

  .preloader__bar {
    width: min(12rem, 40vw);
    height: 2px;
    overflow: hidden;
    background: var(--border);
  }

  .preloader__bar::after {
    content: '';
    display: block;
    width: 40%;
    height: 100%;
    background: var(--accent);
    animation: preloader-scan 900ms var(--ease-in-out) infinite;
  }

  .preloader__label {
    margin: 0;
    text-align: center;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  @keyframes preloader-scan {
    0% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(280%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader {
      display: none !important;
    }
  }
</style>
