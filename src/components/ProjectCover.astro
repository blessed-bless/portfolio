---
import { coverPublicUrl } from '../lib/paths';

interface Props {
  src: string;
  alt?: string;
  loading?: 'lazy' | 'eager';
  /** Unique shared-element name for View Transitions (one per page). */
  transitionName?: string;
}

const { src, alt = '', loading = 'lazy', transitionName } = Astro.props;
const darkHref = coverPublicUrl(src);
const lightHref = darkHref.replace('/covers/', '/covers/light/');
---

{
  transitionName ? (
    <span
      class="project-cover-wrap"
      data-cover-src={darkHref}
      data-cover-src-light={lightHref}
      data-vt-cover={transitionName}
      transition:name={transitionName}
    >
      <img
        class="project-cover project-cover--dark"
        src={darkHref}
        alt={alt}
        width="1600"
        height="1000"
        decoding="async"
        loading={loading}
      />
      <img
        class="project-cover project-cover--light"
        src={lightHref}
        alt=""
        width="1600"
        height="1000"
        decoding="async"
        loading={loading}
        aria-hidden="true"
      />
    </span>
  ) : (
    <span class="project-cover-wrap" data-cover-src={darkHref} data-cover-src-light={lightHref}>
      <img
        class="project-cover project-cover--dark"
        src={darkHref}
        alt={alt}
        width="1600"
        height="1000"
        decoding="async"
        loading={loading}
      />
      <img
        class="project-cover project-cover--light"
        src={lightHref}
        alt=""
        width="1600"
        height="1000"
        decoding="async"
        loading={loading}
        aria-hidden="true"
      />
    </span>
  )
}

<style is:global>
  .project-cover-wrap {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--bg-elevated);
    position: relative;
  }

  .project-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--bg-elevated);
  }

  .project-cover-wrap .project-cover {
    position: absolute;
    inset: 0;
  }

  html[data-theme='light'] .project-cover--dark {
    visibility: hidden;
  }

  html:not([data-theme='light']) .project-cover--light {
    visibility: hidden;
  }
</style>
