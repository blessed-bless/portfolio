---
import { coverPublicUrl } from '../lib/paths';

interface Props {
  src: string;
  alt?: string;
  loading?: 'lazy' | 'eager';
  /** Unique shared-element name for View Transitions (one per page). */
  transitionName?: string;
  /** 1-based index shown as 01 — omit to hide number overlay. */
  index?: number;
  /** Localized title drawn over the cover (same seat as former SVG text). */
  title?: string;
  /** Visible label matching parent aria-label (e.g. "01 · Title"). */
  label?: string;
}

const { src, alt = '', loading = 'lazy', transitionName, index, title, label } = Astro.props;
const darkHref = coverPublicUrl(src);
const lightHref = darkHref.replace('/covers/', '/covers/light/');
const number =
  typeof index === 'number' && Number.isFinite(index)
    ? String(Math.max(1, Math.floor(index))).padStart(2, '0')
    : null;
const metaLabel =
  label ||
  (number && title ? `${number} · ${title}` : number || title || null);
const showMeta = Boolean(metaLabel);
const fetchPriority = loading === 'eager' ? 'high' : undefined;
// Inactive theme cover stays lazy — avoids competing with LCP.
const inactiveLoading = 'lazy' as const;
---

{
  transitionName ? (
    <span
      class="project-cover-wrap"
      data-cover-src={darkHref}
      data-cover-src-light={lightHref}
      data-vt-cover={transitionName}
      transition:name={transitionName}
    >
      <img
        class="project-cover project-cover--dark"
        src={darkHref}
        alt={alt}
        width="1600"
        height="1000"
        decoding="async"
        loading={loading}
        fetchpriority={fetchPriority}
      />
      <img
        class="project-cover project-cover--light"
        src={lightHref}
        alt=""
        width="1600"
        height="1000"
        decoding="async"
        loading={inactiveLoading}
        aria-hidden="true"
      />
      {showMeta ? (
        <span class="project-cover__meta" aria-hidden="true">
          {number ? <span class="project-cover__num">{number}</span> : null}
          {number && title ? <span class="project-cover__dot"> · </span> : null}
          {title ? <span class="project-cover__title">{title}</span> : null}
          {!number && !title && metaLabel ? metaLabel : null}
        </span>
      ) : null}
    </span>
  ) : (
    <span class="project-cover-wrap" data-cover-src={darkHref} data-cover-src-light={lightHref}>
      <img
        class="project-cover project-cover--dark"
        src={darkHref}
        alt={alt}
        width="1600"
        height="1000"
        decoding="async"
        loading={loading}
        fetchpriority={fetchPriority}
      />
      <img
        class="project-cover project-cover--light"
        src={lightHref}
        alt=""
        width="1600"
        height="1000"
        decoding="async"
        loading={inactiveLoading}
        aria-hidden="true"
      />
      {showMeta ? (
        <span class="project-cover__meta" aria-hidden="true">
          {number ? <span class="project-cover__num">{number}</span> : null}
          {number && title ? <span class="project-cover__dot"> · </span> : null}
          {title ? <span class="project-cover__title">{title}</span> : null}
          {!number && !title && metaLabel ? metaLabel : null}
        </span>
      ) : null}
    </span>
  )
}

<style is:global>
  .project-cover-wrap {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--bg-elevated);
    position: relative;
    contain: layout paint;
    overflow: hidden;
    container-type: inline-size;
  }

  .project-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--bg-elevated);
  }

  .project-cover-wrap .project-cover {
    position: absolute;
    inset: 0;
  }

  html[data-theme='light'] .project-cover--dark {
    visibility: hidden;
  }

  html:not([data-theme='light']) .project-cover--light {
    visibility: hidden;
  }

  /* Former SVG seats: number @ (100,144), title @ (206,144), Unbounded ~42/1600. */
  .project-cover__meta {
    position: absolute;
    left: 6.25%;
    top: 10.2%;
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: 0;
    max-width: 86%;
    pointer-events: none;
    font-family: 'Unbounded', system-ui, sans-serif;
    font-weight: 650;
    font-size: max(0.7rem, 2.625cqw);
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--fg);
  }

  .project-cover__num {
    color: var(--accent-strong);
    flex: 0 0 auto;
  }

  .project-cover__dot {
    color: var(--accent-strong);
    flex: 0 0 auto;
    white-space: pre;
  }

  .project-cover__title {
    color: var(--fg);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
