---
import { coverPublicUrl } from '../lib/paths';

interface Props {
  src: string;
  alt?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt = '', loading = 'lazy' } = Astro.props;
const href = coverPublicUrl(src);
---

<img
  class="project-cover"
  src={href}
  alt={alt}
  width="1600"
  height="1000"
  decoding="async"
  loading={loading}
  data-cover-src={href}
/>

<style is:global>
  .project-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--bg-elevated);
  }
</style>
