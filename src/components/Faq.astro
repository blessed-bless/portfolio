---
import { faqItems } from '../data/home';
import { isFilled } from '../lib/fill';

const items = faqItems.filter((item) => isFilled(item.answer));
const faqLd =
  items.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: items.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      }
    : null;
---

{
  items.length > 0 ? (
    <section class="faq page-pad" id="faq" data-faq aria-label="Частые вопросы">
      <div class="faq__intro">
        <p class="eyebrow">FAQ</p>
        <h2 class="faq__title">Частые вопросы</h2>
      </div>
      <div class="faq__list">
        {items.map((item) => (
          <details class="faq__item">
            <summary data-cursor="hover">{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
      {faqLd ? <script type="application/ld+json" set:html={JSON.stringify(faqLd)} /> : null}
    </section>
  ) : null
}

<style>
  .faq {
    padding-block: var(--section-gap);
    border-top: var(--stroke) solid var(--border);
  }

  .faq__intro {
    margin-bottom: var(--space-6);
  }

  .faq__title {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
  }

  .faq__list {
    display: grid;
    gap: var(--space-3);
    max-width: 42rem;
  }

  .faq__item {
    border-bottom: var(--stroke) solid var(--border);
    padding-block: var(--space-3);
  }

  .faq__item summary {
    cursor: pointer;
    font-weight: 650;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item p {
    margin: var(--space-3) 0 0;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }
</style>
