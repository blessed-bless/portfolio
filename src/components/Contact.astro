---
import Button from './Button.astro';
import { contactLinks } from '../data/home';
import { isFilled } from '../lib/fill';
import { defaultLocale, isLocale, ui, type Locale } from '../i18n';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
const title = t.home.contactTitle;
const letters = [...title];
const telegram = isFilled(contactLinks.telegram) ? contactLinks.telegram : null;
const github = isFilled(contactLinks.github) ? contactLinks.github : null;
const email = isFilled(contactLinks.email) ? contactLinks.email : null;
const hasLinks = Boolean(telegram || github || email);
---

<section class="contact page-pad" id="contact" data-contact aria-label={t.nav.contact}>
  <p class="eyebrow">{t.nav.contact}</p>
  <h2 class="contact__title" data-magnetic-title aria-label={title}>
    {
      letters.map((ch) =>
        ch === ' ' ? (
          <span class="contact__space">&nbsp;</span>
        ) : (
          <span class="contact__letter">{ch}</span>
        ),
      )
    }
  </h2>

  {
    hasLinks ? (
      <div class="contact__body">
        {telegram ? (
          <>
            <p class="contact__hint">{t.home.contactHint}</p>
            <div class="contact__cta">
              <Button href={telegram} variant="primary">
                Telegram
              </Button>
              {email ? (
                <Button href={`mailto:${email}`} variant="ghost">
                  {t.home.contactWrite}
                </Button>
              ) : null}
            </div>
          </>
        ) : email ? (
          <div class="contact__cta">
            <Button href={`mailto:${email}`} variant="primary">
              {t.home.contactWrite}
            </Button>
          </div>
        ) : null}

        <div class="contact__links">
          {github ? (
            <a class="contact__link" href={github} data-cursor="hover">
              GitHub
            </a>
          ) : null}
          {email ? (
            <button
              class="contact__link contact__link--email"
              type="button"
              data-copy-email
              data-email={email}
              data-copy-label={t.home.copied}
              data-cursor="hover"
            >
              {email}
            </button>
          ) : null}
        </div>
      </div>
    ) : (
      <p class="contact__pending">{t.home.contactPending}</p>
    )
  }

  <p class="contact__toast mono" data-copy-toast data-open="false" role="status" aria-live="polite"></p>
</section>

<style>
  .contact {
    position: relative;
    padding-block: var(--section-gap);
    border-top: var(--stroke) solid var(--border);
  }

  .contact__title {
    margin: var(--space-4) 0 0;
    font-size: clamp(2.6rem, 1.2rem + 8.5vw, 7.5rem);
    font-weight: 750;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    padding-bottom: 0.08em;
    overflow: visible;
  }

  .contact__letter,
  .contact__space {
    display: inline-block;
    will-change: transform;
    line-height: 1;
  }

  .contact__body {
    margin-top: var(--space-7);
    display: grid;
    gap: var(--space-5);
    max-width: 40rem;
  }

  .contact__hint {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--text-md);
    line-height: var(--leading-body);
    max-width: 36rem;
  }

  .contact__pending {
    margin: var(--space-7) 0 0;
    color: var(--fg-muted);
    max-width: 28rem;
  }

  .contact__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
  }

  .contact__link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg);
    background: none;
    border: 0;
    padding: 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .contact__link:hover {
    color: var(--accent-strong);
  }

  .contact__link--email {
    cursor: pointer;
  }

  .contact__toast {
    position: fixed;
    left: 50%;
    bottom: var(--space-5);
    z-index: 50;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: var(--stroke) solid var(--border-strong);
    background: var(--bg-elevated);
    color: var(--fg);
    font-size: var(--text-xs);
    text-transform: uppercase;
    transform: translateX(-50%) translateY(120%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform var(--dur-3) var(--ease-out),
      opacity var(--dur-2) var(--ease-out);
  }

  .contact__toast[data-open='true'] {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }
</style>
