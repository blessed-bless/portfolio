---
import Button from './Button.astro';
import { contactLinks } from '../data/home';
import { defaultLocale, isLocale } from '../i18n';

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const english = locale === 'en';
const email = contactLinks.email;
---

<section class="contact page-pad" id="contact" data-contact aria-labelledby="contact-title">
  <h2 class="contact__title" id="contact-title">{english ? 'Tell me about your project' : 'Расскажите о задаче'}</h2>
  <p class="contact__hint">
    {english
      ? 'Tell me what your business does, how enquiries come in today, and where you run into problems. I’ll ask a few questions and give you an initial estimate.'
      : 'Напишите, чем занимается бизнес, как сейчас приходят заявки и где возникает проблема. Я уточню детали и дам предварительную оценку.'}
  </p>
  <project-contact
    class="contact__actions"
    data-email={email}
    data-copied={english ? 'Email address copied' : 'Адрес почты скопирован'}
    data-copy-error={english ? 'Couldn’t copy the address. You can select it next to the button.' : 'Не удалось скопировать адрес. Его можно выделить рядом с кнопкой.'}
  >
    <div class="contact__links">
      <span class="roll">
        <Button class="roll-cta" href={contactLinks.telegram} variant="primary" data-telegram-handoff>
          <svg class="roll__spin" viewBox="0 0 100 100" aria-hidden="true">
            <defs>
              <path id="contact-roll" d="M50,50 m-36,0 a36,36 0 1,1 72,0 a36,36 0 1,1 -72,0" />
            </defs>
            <text>
              <textPath href="#contact-roll">
                {english ? 'Write · Write · Write · ' : 'Написать · Написать · '}
              </textPath>
            </text>
          </svg>
          <span class="roll__face">{english ? 'Message on Telegram' : 'Написать в Telegram'}</span>
        </Button>
      </span>
      <Button href={`mailto:${email}`} variant="ghost">{email}</Button>
      <button type="button" class="contact__copy" data-copy-email hidden>
        {english ? 'Copy address' : 'Скопировать адрес'}
      </button>
    </div>
    <p class="contact__status" data-copy-status role="status"></p>
  </project-contact>
</section>

<script>
  class ProjectContact extends HTMLElement {
    connectedCallback() {
      const copy = this.querySelector<HTMLButtonElement>('[data-copy-email]');
      const status = this.querySelector<HTMLElement>('[data-copy-status]');
      if (!copy || !status || !copy.hidden) return;
      copy.addEventListener('click', async () => {
        const email = this.dataset.email;
        if (!email) return;
        try {
          await navigator.clipboard.writeText(email);
          status.textContent = this.dataset.copied ?? '';
        } catch {
          status.textContent = this.dataset.copyError ?? '';
        }
      });
      copy.hidden = false;
    }
  }

  customElements.define('project-contact', ProjectContact);
</script>

<style>
  .contact {
    padding-block: var(--section-gap);
    border-top: var(--stroke) solid var(--border);
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .contact:target {
    border-top-color: var(--accent);
  }

  .contact__title {
    margin: 0;
    max-width: 24ch;
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .contact__hint {
    margin: var(--space-4) 0 0;
    max-width: 56ch;
    color: var(--fg-muted);
  }

  .contact__actions {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    overflow-wrap: anywhere;
  }

  .contact__status {
    margin: 0;
    color: var(--fg-muted);
    min-height: 1.5em;
  }

  .contact__copy {
    min-height: 44px;
    padding-inline: var(--space-3);
    border: var(--stroke) solid var(--border-strong);
    background: transparent;
    color: var(--fg);
    font: inherit;
    cursor: pointer;
  }

  [data-copy-email][hidden] {
    display: none;
  }

  .roll :global(.roll-cta) {
    position: relative;
    width: 8.75rem;
    height: 8.75rem;
    padding: 1.4rem;
    border-radius: 50%;
    overflow: hidden;
    text-align: center;
  }

  .roll__spin {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: roll-spin 14s linear infinite;
  }

  .roll__spin text {
    fill: currentColor;
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .roll__face {
    position: relative;
    font-size: 0.78rem;
    line-height: 1.2;
  }

  @keyframes roll-spin {
    to { transform: rotate(1turn); }
  }

  @media (prefers-reduced-motion: reduce) {
    .roll__spin { animation: none; }
  }
</style>
