---
import ProjectCover from './ProjectCover.astro';
import Button from './Button.astro';
import { getCarouselProjects } from '../lib/work';
import { contactLinks } from '../data/home';
import { isFilled } from '../lib/fill';
import { defaultLocale, isLocale, localizedPath, ui, type Locale } from '../i18n';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
const projects = await getCarouselProjects(locale);
const projectsJson = JSON.stringify(projects);
const firstProject = projects[0];
const telegram = isFilled(contactLinks.telegram) ? contactLinks.telegram : null;
---

<section
  class="hero"
  data-hero
  data-locale={locale}
  aria-label={t.home.heroHeadline}
  data-projects={projectsJson}
>
  <div class="hero__copy">
    <p class="hero__brand" data-hero-name>{t.brand}</p>
    <h1 class="hero__line" data-hero-line data-page-title>{t.home.heroHeadline}</h1>
    <p class="hero__sub" data-hero-sub>{t.home.heroSubtitle}</p>
    <div class="hero__actions" data-hero-foot>
      {
        telegram ? (
          <Button href={telegram} variant="primary">
            {t.home.heroCta}
          </Button>
        ) : null
      }
      <Button href={localizedPath(locale, '/work/')} variant="ghost">
        {t.home.heroWork}
      </Button>
    </div>
  </div>

  <div class="hero__stage-wrap">
    <div class="hero__stage">
      <canvas class="hero__canvas" data-hero-canvas data-lenis-prevent></canvas>
      <div class="hero__static" data-hero-static>
        {
          projects.map((project, index) => {
            const label = `${String(index + 1).padStart(2, '0')} · ${project.title}`;
            return (
              <a
                class="hero__static-card"
                href={localizedPath(locale, `/work/${project.slug}/`)}
                data-cursor="hover"
                aria-label={label}
                data-hero-cover={project.slug}
              >
                <ProjectCover src={project.cover} loading={index === 0 ? 'eager' : 'lazy'} />
              </a>
            );
          })
        }
      </div>
    </div>

    <div class="hero__chrome">
      <p class="hero__counter mono" data-hero-counter>01 / {String(projects.length).padStart(2, '0')}</p>
      <div class="hero__nav" role="group" aria-label="Листание карусели">
        <button type="button" class="hero__nav-btn mono" data-hero-prev data-cursor="hover" aria-label="Предыдущий проект">
          ←
        </button>
        <button type="button" class="hero__nav-btn mono" data-hero-next data-cursor="hover" aria-label="Следующий проект">
          →
        </button>
      </div>
      <p class="hero__hint mono" data-hero-hint>тяните или ← →</p>
      <p class="hero__caption mono" data-hero-caption aria-live="polite">
        {firstProject && (
          <>
            <span>01</span>
            <span>{firstProject.title}</span>
            <span>{firstProject.year}</span>
            <span>{firstProject.stack}</span>
          </>
        )}
      </p>
    </div>
  </div>
</section>

<script>
  import type { Project } from '../lib/work-types';

  let sceneTeardown: (() => void) | null = null;

  function readProjects(root: HTMLElement): Project[] {
    try {
      const raw = root.dataset.projects || '[]';
      const parsed = JSON.parse(raw) as Project[];
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  async function openProject(project: Project): Promise<void> {
    if (!project.hasPage) return;
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const { expandToWorkPage, projectPlaneScreenRect } = await import('../scripts/hero-scene');
    const from =
      (canvas && projectPlaneScreenRect(canvas)) ||
      new DOMRect(window.innerWidth * 0.35, window.innerHeight * 0.28, 480, 320);
    await expandToWorkPage(project, from);
    const { navigate } = await import('astro:transitions/client');
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const locale = hero?.dataset.locale === 'en' ? 'en' : 'ru';
    navigate(locale === 'en' ? `/en/work/${project.slug}/` : `/work/${project.slug}/`);
    window.setTimeout(() => {
      document.querySelectorAll('.work-expand').forEach((node) => node.remove());
    }, 900);
  }

  async function bootHero(): Promise<void> {
    const root = document.querySelector<HTMLElement>('[data-hero]');
    if (!root) return;

    sceneTeardown?.();
    sceneTeardown = null;

    const projects = readProjects(root);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const caption = root.querySelector<HTMLElement>('[data-hero-caption]');
    const counter = root.querySelector<HTMLElement>('[data-hero-counter]');
    const hint = root.querySelector<HTMLElement>('[data-hero-hint]');
    const staticGrid = root.querySelector<HTMLElement>('[data-hero-static]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-hero-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-hero-next]');

    const { isWeakGpu, mountHeroFallback } = await import('../scripts/hero-fallback');
    const preferFallback = reduce || isWeakGpu();

    const enableFallback = (): void => {
      if (!staticGrid) return;
      canvas?.setAttribute('hidden', '');
      sceneTeardown = mountHeroFallback(root, staticGrid, {
        projects,
        counter,
        caption,
        hint,
        onSelect: (project) => {
          void openProject(project);
        },
      });
    };

    let playIntro: (() => Promise<void>) | null = null;

    if (preferFallback) {
      enableFallback();
    } else if (canvas) {
      root.dataset.webgl = 'pending';
      staticGrid?.removeAttribute('hidden');

      const scenePromise = (async () => {
        await new Promise<void>((resolve) => {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(() => resolve(), { timeout: 1200 });
          } else {
            window.setTimeout(() => resolve(), 220);
          }
        });
        if (!document.contains(root)) return null;
        const { mountHeroScene } = await import('../scripts/hero-scene');
        const handle = await mountHeroScene(canvas, {
          projects,
          caption,
          counter,
          hint,
          reducedMotion: false,
          onSelect: (project) => {
            void openProject(project);
          },
        });
        if (!document.contains(root)) {
          handle?.dispose();
          return null;
        }
        return handle;
      })();

      playIntro = async () => {
        const handle = await scenePromise;
        if (!handle) {
          enableFallback();
          return;
        }
        root.dataset.webgl = 'on';
        root.dataset.carousel = 'webgl';
        const onPrev = (): void => handle.goBy(-1);
        const onNext = (): void => handle.goBy(1);
        prevBtn?.addEventListener('click', onPrev);
        nextBtn?.addEventListener('click', onNext);
        sceneTeardown = () => {
          prevBtn?.removeEventListener('click', onPrev);
          nextBtn?.removeEventListener('click', onNext);
          handle.dispose();
        };
        staticGrid?.setAttribute('hidden', '');
        canvas.removeAttribute('hidden');
        await handle.playIntro();
      };
    } else {
      enableFallback();
    }

    if (preferFallback) return;

    if (window.matchMedia('(max-width: 900px)').matches) {
      await playIntro?.();
      return;
    }

    const { animateHeroIntro } = await import('../scripts/hero-split');
    await animateHeroIntro(root, {
      onCarouselEnter: async () => {
        await playIntro?.();
      },
    });
  }

  let activeHero: HTMLElement | null = null;

  function startHero(): void {
    const root = document.querySelector<HTMLElement>('[data-hero]');
    if (!root || root === activeHero) return;
    activeHero = root;
    void bootHero();
  }

  startHero();
  document.addEventListener('astro:page-load', startHero);
  document.addEventListener('astro:before-swap', () => {
    activeHero = null;
    sceneTeardown?.();
    sceneTeardown = null;
  });
</script>

<style>
  .hero {
    --hero-copy-w: clamp(16rem, 34vw, 30rem);
    position: relative;
    isolation: isolate;
    height: calc(100svh - var(--header-h));
    max-height: calc(100svh - var(--header-h));
    overflow: hidden;
    background: var(--bg);
  }

  .hero__copy {
    position: relative;
    z-index: 3;
    box-sizing: border-box;
    width: var(--hero-copy-w);
    height: 100%;
    padding: clamp(1rem, 3vh, 2rem) var(--space-4) clamp(1rem, 3vh, 2rem) var(--page-pad);
    display: grid;
    align-content: center;
    gap: var(--space-3);
    pointer-events: none;
  }

  .hero__copy > * {
    pointer-events: auto;
  }

  .hero__brand,
  .hero__line,
  .hero__sub {
    margin: 0;
    overflow: hidden;
  }

  .hero__brand {
    font-size: clamp(2.4rem, 1.6rem + 3vw, 4.5rem);
    font-weight: 750;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }

  .hero__line {
    max-width: 16ch;
    font-size: clamp(1.35rem, 1rem + 1.5vw, 2.15rem);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    color: color-mix(in srgb, var(--fg) 88%, var(--accent-strong));
  }

  .hero__sub {
    max-width: 28ch;
    font-size: var(--text-sm);
    color: var(--fg-muted);
    line-height: var(--leading-body);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero__stage-wrap {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 62%;
    z-index: 1;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    align-content: stretch;
    pointer-events: none;
    background: transparent;
  }

  .hero__stage {
    position: relative;
    min-height: 0;
    height: 100%;
    margin-block: clamp(0.25rem, 1.2vh, 0.75rem) 0;
    overflow: visible;
    background: transparent;
    border: 0;
    pointer-events: auto;
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, #000 10%, #000 100%),
      linear-gradient(180deg, transparent 0%, #000 2%, #000 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 10%, #000 100%),
      linear-gradient(180deg, transparent 0%, #000 2%, #000 100%);
    mask-composite: intersect;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--dur-4) var(--ease-out);
    touch-action: none;
  }

  .hero[data-webgl='on'] .hero__canvas[data-ready='true'] {
    opacity: 1;
  }

  .hero__chrome {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: var(--space-1) var(--space-3);
    align-items: center;
    margin-top: -0.35rem;
    padding: 0 var(--page-pad) clamp(0.4rem, 1.2vh, 0.75rem) var(--space-5);
    pointer-events: none;
    isolation: isolate;
  }

  .hero__nav {
    display: inline-flex;
    gap: var(--space-2);
    pointer-events: auto;
  }

  .hero__nav-btn {
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.65rem;
    border: var(--stroke) solid var(--border);
    background: var(--bg-elevated);
    color: var(--fg);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .hero__nav-btn:hover,
  .hero__nav-btn:focus-visible {
    border-color: var(--border-strong);
    color: var(--accent-strong);
  }

  .hero__counter,
  .hero__hint,
  .hero__caption {
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .hero__counter {
    color: var(--accent-strong);
  }

  .hero__hint {
    color: var(--fg-muted);
    justify-self: end;
    grid-column: 3;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .hero__hint[data-hidden='true'] {
    opacity: 0;
  }

  .hero__caption {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    color: var(--fg);
    overflow: hidden;
    min-height: 1.2em;
  }

  .hero__caption span:nth-child(3),
  .hero__caption span:nth-child(4) {
    color: var(--fg-muted);
  }

  .hero__caption :global(.caption-char) {
    display: inline-block;
  }

  .hero__caption span:nth-child(1),
  .hero__caption span:nth-child(2) {
    color: var(--accent-strong);
  }

  .hero__static {
    position: absolute;
    inset: 4% 3% 8%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    align-content: center;
    pointer-events: auto;
  }

  .hero__static[hidden] {
    display: none;
  }

  .hero[data-carousel='snap'] .hero__static {
    inset: auto 0 6%;
    top: 4%;
    bottom: 6%;
    display: flex;
    gap: var(--space-4);
    padding-inline: var(--page-pad);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-pad);
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    align-items: center;
    cursor: grab;
    touch-action: pan-x;
  }

  .hero[data-carousel='snap'] .hero__static:active {
    cursor: grabbing;
  }

  .hero[data-carousel='snap'] .hero__static-card {
    flex: 0 0 min(78vw, 28rem);
    scroll-snap-align: center;
  }

  .hero[data-carousel='snap'] .hero__static-card[data-active='true'] {
    border-color: var(--border-strong);
  }

  .hero__static-card {
    aspect-ratio: 16 / 10;
    display: block;
    border: var(--stroke) solid var(--border);
    background-color: var(--bg-elevated);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  :global(.hero-char) {
    display: inline-block;
    will-change: transform, opacity;
  }

  :global(.hero-word) {
    display: inline-block;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .hero {
      display: grid;
      grid-template-rows: auto minmax(48svh, 1fr);
      height: auto;
      max-height: none;
      min-height: calc(100svh - var(--header-h));
      overflow: visible;
    }

    .hero__copy {
      width: 100%;
      height: auto;
      align-content: start;
      gap: var(--space-2);
      padding: var(--space-3) var(--page-pad) var(--space-2);
    }

    .hero__brand {
      font-size: clamp(2rem, 8vw, 2.8rem);
    }

    .hero__line {
      max-width: 20ch;
      font-size: clamp(1.1rem, 4vw, 1.4rem);
    }

    .hero__stage-wrap {
      position: relative;
      width: 100vw;
      max-width: 100vw;
      margin-inline: calc(50% - 50vw);
      height: auto;
      min-height: 55svh;
    }

    .hero__stage {
      min-height: 55svh;
      -webkit-mask-image: linear-gradient(
        90deg,
        transparent 0%,
        #000 1.5%,
        #000 98.5%,
        transparent 100%
      );
      -webkit-mask-composite: source-over;
      mask-image: linear-gradient(
        90deg,
        transparent 0%,
        #000 1.5%,
        #000 98.5%,
        transparent 100%
      );
      mask-composite: add;
    }

    .hero__chrome {
      padding: var(--space-2) var(--page-pad) var(--space-4);
    }

    .hero__static {
      inset: 4% var(--page-pad) 18%;
    }

    .hero[data-carousel='snap'] .hero__static {
      inset: auto 0 16%;
      top: 6%;
      bottom: 16%;
    }

    .hero[data-carousel='snap'] .hero__static-card {
      flex-basis: min(86vw, 22rem);
    }
  }
</style>
