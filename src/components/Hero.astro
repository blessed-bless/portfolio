---
import ProjectCover from './ProjectCover.astro';
import Button from './Button.astro';
import { getProjects } from '../lib/work';
import { contactLinks } from '../data/home';
import { featuredWorkCopy } from '../data/featured-work';
import { isFilled } from '../lib/fill';
import { defaultLocale, isLocale, localizedPath, ui, type Locale } from '../i18n';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
const headline = `${t.home.heroHeadline} ${t.home.heroHeadlineAccent}`;
const projects = await getProjects(locale);
const slides = projects.map((project) => {
  const copy = featuredWorkCopy[project.slug]?.[locale];
  return {
    ...project,
    category: copy?.category ?? project.role,
    result: copy?.scenario ?? project.summary,
    action: copy?.action ?? (locale === 'en' ? 'Read the case' : 'Читать кейс'),
    actionHref: copy
      ? project.links.live ?? localizedPath(locale, `/work/${project.slug}/#demo`)
      : localizedPath(locale, `/work/${project.slug}/`),
  };
});
const projectsJson = JSON.stringify(slides);
const firstProject = slides[0];
const telegram = isFilled(contactLinks.telegram) ? contactLinks.telegram : null;
---

<section
  class="hero page-pad"
  data-hero
  data-locale={locale}
  aria-label={headline}
  data-carousel-label={t.home.carouselNav}
  data-projects={projectsJson}
>
  <div class="hero__copy">
    <p class="hero__brand" data-hero-name>{t.brand}</p>
    <h1 class="hero__line" data-hero-line data-page-title aria-label={headline}>
      <span>{t.home.heroHeadline}</span>
      <span class="hero__headline-accent">{t.home.heroHeadlineAccent}</span>
    </h1>
    <p class="hero__sub" data-hero-sub>{t.home.heroSubtitle}</p>
    <div class="hero__actions">
      {
        telegram ? (
          <Button href={telegram} variant="primary" data-telegram-handoff>
            {t.home.heroCta}
          </Button>
        ) : null
      }
      <Button href={localizedPath(locale, '/order/')} variant={telegram ? 'link' : 'primary'}>{t.home.heroServices}</Button>
    </div>
  </div>

  <div class="hero__stage-wrap">
    <div class="hero__stage">
      <canvas class="hero__canvas" data-hero-canvas data-cursor="drag" tabindex="0" aria-roledescription="carousel"></canvas>
      <div class="hero__grain" data-hero-grain aria-hidden="true"></div>
      <div class="hero__static" data-hero-static>
        {
          slides.map((project, index) => {
            const number = String(index + 1).padStart(2, '0');
            return (
              <a
                class="hero__static-card"
                href={localizedPath(locale, `/work/${project.slug}/`)}
                data-cursor="hover"
                aria-label={`${number} · ${project.title}`}
                aria-current={index === 0 ? 'true' : undefined}
                data-active={String(index === 0)}
                data-hero-cover={project.slug}
              >
                <ProjectCover
                  src={project.cover}
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
                <span class="hero__cover-motion" aria-hidden="true"><i></i><i></i></span>
              </a>
            );
          })
        }
      </div>
      <button
        class="hero__replay"
        type="button"
        data-hero-replay
        aria-label={locale === 'en' ? 'Replay cover animation' : 'Повторить анимацию обложки'}
        title={locale === 'en' ? 'Replay cover animation' : 'Повторить анимацию обложки'}
        hidden
      >↻</button>
    </div>

    <div class="hero__chrome">
      {firstProject && (
        <div class="hero__caption" data-hero-caption>
          <div class="hero__caption-copy" data-hero-caption-copy aria-live="polite" aria-atomic="true">
            <p class="hero__category mono" data-hero-category>{firstProject.category}</p>
            <p class="hero__project-title" data-hero-project-title>{firstProject.title}</p>
            <p class="hero__result" data-hero-result>{firstProject.result}</p>
          </div>
          <a
            class="hero__case-link"
            data-hero-action
            href={firstProject.actionHref}
            data-demo-from={firstProject.actionHref.endsWith('#demo') ? 'hero' : undefined}
            data-demo-start={firstProject.actionHref.endsWith('#demo') ? firstProject.slug : undefined}
          >
            <span data-hero-action-label>{firstProject.action}</span> <span aria-hidden="true">→</span>
          </a>
        </div>
      )}
      <div class="hero__nav" role="group" aria-label={t.home.carouselNav}>
        <button type="button" class="hero__nav-btn mono" data-hero-prev data-cursor="hover" aria-label={t.home.carouselPrev} disabled>←</button>
        <button type="button" class="hero__nav-btn mono" data-hero-next data-cursor="hover" aria-label={t.home.carouselNext} disabled>→</button>
      </div>
      <div class="hero__position">
        <div class="hero__meter" aria-hidden="true">
          {slides.map((project, index) => <span data-hero-step={project.slug} data-current={String(index === 0)} />)}
        </div>
        <p class="hero__counter mono" data-hero-counter>01 / {String(slides.length).padStart(2, '0')}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import type { Project } from '../lib/work-types';

  type HeroProject = Project & { category: string; result: string; action: string; actionHref: string };

  let sceneTeardown: (() => void) | null = null;

  function readProjects(root: HTMLElement): HeroProject[] {
    try {
      const raw = root.dataset.projects || '[]';
      const parsed = JSON.parse(raw) as HeroProject[];
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  async function bootHero(root: HTMLElement, showIntro: boolean): Promise<void> {
    sceneTeardown?.();
    sceneTeardown = null;

    const projects = readProjects(root);
    const canvas = root.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const caption = root.querySelector<HTMLElement>('[data-hero-caption-copy]');
    const title = root.querySelector<HTMLElement>('[data-hero-project-title]');
    const category = root.querySelector<HTMLElement>('[data-hero-category]');
    const action = root.querySelector<HTMLAnchorElement>('[data-hero-action]');
    const actionLabel = root.querySelector<HTMLElement>('[data-hero-action-label]');
    const counter = root.querySelector<HTMLElement>('[data-hero-counter]');
    const steps = [...root.querySelectorAll<HTMLElement>('[data-hero-step]')];
    const caseLinks = [...root.querySelectorAll<HTMLAnchorElement>('[data-hero-cover]')];
    let captionAnimation: Animation | undefined;
    let activeIndex = 0;
    const updateProject = (index: number): void => {
      const project = projects[index];
      if (!project || activeIndex === index) return;
      activeIndex = index;
      const number = String(index + 1).padStart(2, '0');
      const total = String(projects.length).padStart(2, '0');
      if (title) title.textContent = project.title;
      if (category) category.textContent = project.category;
      const result = root.querySelector<HTMLElement>('[data-hero-result]');
      if (result) result.textContent = project.result;
      if (counter) counter.textContent = `${number} / ${total}`;
      if (action && actionLabel) {
        actionLabel.textContent = project.action;
        action.href = project.actionHref;
        if (project.actionHref.endsWith('#demo')) {
          action.dataset.demoStart = project.slug;
          action.dataset.demoFrom = 'hero';
        } else {
          delete action.dataset.demoStart;
          delete action.dataset.demoFrom;
        }
      }
      steps.forEach((step, i) => { step.dataset.current = String(i === index); });
      captionAnimation?.cancel();
      if (caption && !isLessMotionPreferred()) {
        captionAnimation = caption.animate(
          [{ opacity: 0.55, translate: '0 7px' }, { opacity: 1, translate: '0 0' }],
          { duration: 280, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
        );
      }
    };
    const staticGrid = root.querySelector<HTMLElement>('[data-hero-static]');
    const replayBtn = root.querySelector<HTMLButtonElement>('[data-hero-replay]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-hero-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-hero-next]');
    const enableControls = (): void => {
      if (prevBtn) prevBtn.disabled = false;
      if (nextBtn) nextBtn.disabled = false;
      if (replayBtn) replayBtn.hidden = false;
    };
    const onHeroKey = (event: KeyboardEvent): void => {
      if (event.target === canvas) return;
      if (!root.contains(document.activeElement)) return;
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      if (event.key === 'ArrowLeft') prevBtn?.click();
      else nextBtn?.click();
    };
    root.addEventListener('keydown', onHeroKey);

    const [{ isWeakGpu, mountHeroFallback }, { getPerfTier, isLessMotionPreferred, perfAllows }] = await Promise.all([
      import('../scripts/hero-fallback'),
      import('../scripts/perf'),
    ]);
    if (!root.isConnected) return;
    // Mobile / narrow: CSS snap — better touch UX and keeps three.js off the critical path.
    const narrow = window.matchMedia('(max-width: 900px)').matches;
    const preferFallback = isLessMotionPreferred() || narrow ||
      getPerfTier() === 'low' || !perfAllows('webgl') || isWeakGpu();

    const enableFallback = (): void => {
      if (!staticGrid) return;
      canvas?.setAttribute('hidden', '');
      const stop = mountHeroFallback(root, staticGrid, updateProject);
      const onReplay = (): void => {
        const motion = caseLinks[activeIndex]?.querySelector<HTMLElement>('.hero__cover-motion');
        motion?.getAnimations({ subtree: true }).forEach((animation) => {
          animation.currentTime = 0;
          animation.play();
        });
      };
      replayBtn?.addEventListener('click', onReplay);
      enableControls();
      sceneTeardown = () => {
        root.removeEventListener('keydown', onHeroKey);
        replayBtn?.removeEventListener('click', onReplay);
        captionAnimation?.cancel();
        stop();
      };
    };

    root.dataset.motion = isLessMotionPreferred() ? 'off' : 'on';
    let playIntro: (() => Promise<void>) | null = null;

    if (preferFallback) {
      enableFallback();
    } else if (canvas) {
      root.dataset.webgl = 'pending';
      staticGrid?.removeAttribute('hidden');

      const scenePromise = (async () => {
        await new Promise<void>((resolve) => {
          const idle = window.requestIdleCallback?.bind(window);
          if (idle) idle(() => resolve(), { timeout: 1200 });
          else setTimeout(() => resolve(), 220);
        });
        if (!document.contains(root)) return null;
        const { mountHeroRing } = await import('../scripts/hero-ring');
        if (!root.isConnected || isLessMotionPreferred()) return null;
        const handle = await mountHeroRing(canvas, {
          projects,
          onActiveIndexChange: updateProject,
          reducedMotion: false,
          showIntro,
          ariaLabel: root.getAttribute('data-carousel-label') || undefined,
          onSelect: (project) => {
            caseLinks.find((link) => link.dataset.heroCover === project.slug)?.click();
          },
        });
        if (!document.contains(root)) {
          handle?.dispose();
          return null;
        }
        return handle;
      })();

      playIntro = async () => {
        const handle = await scenePromise;
        if (!root.isConnected) {
          handle?.dispose();
          return;
        }
        if (!handle || isLessMotionPreferred()) {
          handle?.dispose();
          enableFallback();
          return;
        }
        root.dataset.webgl = 'on';
        root.dataset.carousel = 'webgl';
        const onPrev = (): void => handle.goBy(-1);
        const onNext = (): void => handle.goBy(1);
        prevBtn?.addEventListener('click', onPrev);
        nextBtn?.addEventListener('click', onNext);
        replayBtn?.addEventListener('click', handle.replayCover);
        enableControls();
        sceneTeardown = () => {
          root.removeEventListener('keydown', onHeroKey);
          prevBtn?.removeEventListener('click', onPrev);
          nextBtn?.removeEventListener('click', onNext);
          replayBtn?.removeEventListener('click', handle.replayCover);
          captionAnimation?.cancel();
          handle.dispose();
        };
        staticGrid?.setAttribute('hidden', '');
        canvas.removeAttribute('hidden');
        if (showIntro) await handle.playIntro();
      };
    } else {
      enableFallback();
    }

    if (preferFallback) return;
    if (!showIntro) {
      await playIntro?.();
      return;
    }

    const { animateHeroIntro } = await import('../scripts/hero-split');
    await animateHeroIntro(root, {
      onCarouselEnter: async () => {
        await playIntro?.();
      },
    });
  }

  let activeHero: HTMLElement | null = null;
  let hasVisitedHero = false;

  function startHero(): void {
    const root = document.querySelector<HTMLElement>('[data-hero]');
    if (!root || root === activeHero) return;
    activeHero = root;
    const showIntro = !hasVisitedHero;
    hasVisitedHero = true;
    void bootHero(root, showIntro);
  }

  startHero();
  async function updateMotionPreference(): Promise<void> {
    const root = activeHero;
    if (!root) return;
    const { isLessMotionPreferred } = await import('../scripts/perf');
    if (root === activeHero) root.dataset.motion = isLessMotionPreferred() ? 'off' : 'on';
  }

  window.addEventListener('portfolio:less-motion', () => { void updateMotionPreference(); });
  matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', () => { void updateMotionPreference(); });
  document.addEventListener('astro:page-load', startHero);
  document.addEventListener('astro:before-swap', () => {
    activeHero = null;
    sceneTeardown?.();
    sceneTeardown = null;
  });
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.36fr);
    align-items: start;
    gap: clamp(1.5rem, 4vw, 5rem);
    min-height: calc(100svh - var(--header-h));
    padding-top: clamp(1.25rem, 4vh, 2.75rem);
    padding-bottom: clamp(7rem, 16vh, 9rem);
    background: var(--bg);
    isolation: isolate;
  }

  .hero__copy {
    display: grid;
    align-content: center;
    min-width: 0;
    gap: var(--space-4);
  }

  .hero__brand,
  .hero__line,
  .hero__sub {
    margin: 0;
  }

  .hero__brand {
    justify-self: start;
    padding-block-end: var(--space-2);
    border-bottom: var(--stroke) solid var(--accent-strong);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .hero__line {
    font-size: clamp(2rem, 0.7rem + 4.4vw, 5.1rem);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: 1.04;
    overflow-wrap: anywhere;
  }

  .hero__line > span {
    display: block;
  }

  .hero__headline-accent {
    color: var(--accent-strong);
  }

  .hero__sub {
    max-width: 32ch;
    font-size: var(--text-base);
    color: var(--fg-muted);
    line-height: var(--leading-body);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero__actions :global(.btn--link) {
    min-height: 2.75rem;
  }

  .hero__stage-wrap {
    min-width: 0;
    border: var(--stroke) solid var(--border-strong);
    background: var(--bg-elevated);
  }

  .hero__stage {
    position: relative;
    min-height: 0;
    aspect-ratio: 16 / 10;
    contain: layout paint;
    container-type: inline-size;
    isolation: isolate;
    pointer-events: auto;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-3) var(--ease-out);
    touch-action: none;
  }

  .hero[data-webgl='on'] .hero__canvas[data-ready='true'] {
    opacity: 1;
    pointer-events: auto;
  }

  .hero__chrome {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-3) var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-top: var(--stroke) solid var(--border-strong);
  }

  .hero__caption {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .hero__caption-copy {
    min-width: 0;
  }

  .hero__category,
  .hero__project-title,
  .hero__counter {
    margin: 0;
  }

  .hero__category,
  .hero__counter {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .hero__category {
    color: var(--accent-strong);
  }

  .hero__project-title {
    margin-top: var(--space-1);
    width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1rem + 1vw, 1.78rem);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    overflow-wrap: anywhere;
  }

  .hero__result {
    margin: var(--space-2) 0 0;
    max-width: 42ch;
    color: var(--fg-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .hero__grain {
    display: none;
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.28;
    mix-blend-mode: overlay;
    background-image: radial-gradient(rgb(255 255 255 / 0.45) 0.6px, transparent 0.65px);
    background-size: 3px 3px;
  }

  .hero[data-webgl='on'] .hero__grain {
    display: block;
  }

  .hero__case-link {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    justify-self: start;
    min-height: 44px;
    color: var(--accent-strong);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    pointer-events: auto;
  }

  .hero__case-link:hover,
  .hero__case-link:focus-visible {
    color: var(--accent-strong);
  }

  .hero__nav {
    display: flex;
    gap: var(--space-2);
    align-self: end;
    pointer-events: auto;
  }

  .hero__nav-btn {
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.65rem;
    border: var(--stroke) solid var(--border-strong);
    background: var(--bg-elevated);
    color: var(--fg);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .hero__nav-btn:disabled {
    opacity: 0.55;
    cursor: default;
  }

  .hero__nav-btn:enabled:hover,
  .hero__nav-btn:focus-visible {
    border-color: var(--accent-strong);
    color: var(--accent-strong);
  }

  .hero[data-motion='on'] .hero__nav-btn {
    transition: scale var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
  }

  .hero[data-motion='on'] .hero__nav-btn:active {
    scale: 0.96;
  }

  .hero__position {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .hero__meter {
    display: flex;
    flex: 1;
    gap: var(--space-1);
  }

  .hero__meter > span {
    position: relative;
    flex: 1;
    height: 2px;
    background: var(--border);
  }

  .hero__meter > span::after {
    position: absolute;
    inset: 0;
    content: '';
    background: var(--accent-strong);
    transform-origin: left;
    transform: scaleX(0);
  }

  .hero[data-motion='on'] .hero__meter > span::after {
    transition: transform var(--dur-3) var(--ease-out);
  }

  .hero__meter > span[data-current='true']::after {
    transform: scaleX(1);
  }

  .hero__counter {
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .hero__static {
    --hero-card-width: 92cqi;
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 4cqi;
    padding-inline: calc((100% - var(--hero-card-width)) / 2);
    overflow: auto hidden;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    touch-action: pan-x pan-y;
    cursor: grab;
  }

  .hero__static[hidden] {
    display: none;
  }

  .hero__static[data-dragging] {
    scroll-snap-type: none;
    cursor: grabbing;
    user-select: none;
  }

  .hero__static-card {
    position: relative;
    isolation: isolate;
    flex: 0 0 var(--hero-card-width);
    min-width: 0;
    aspect-ratio: 16 / 10;
    scroll-snap-align: center;
    overflow: hidden;
    background: var(--bg-elevated);
    color: inherit;
  }

  .hero__static-card:focus-visible {
    outline-offset: -4px;
  }

  .hero__static-card :global(.project-cover-wrap) {
    height: 100%;
  }

  .hero__replay {
    position: absolute;
    z-index: 3;
    top: var(--space-3);
    right: var(--space-3);
    width: 44px;
    height: 44px;
    padding: 0;
    border: var(--stroke) solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--fg);
    font-size: 1.2rem;
    cursor: pointer;
  }

  .hero__replay:hover,
  .hero__replay:focus-visible {
    color: var(--accent-strong);
    border-color: var(--accent-strong);
  }

  .hero__replay[hidden],
  .hero:not([data-motion='on']) .hero__replay {
    display: none;
  }

  .hero__cover-motion {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero__cover-motion > i {
    position: absolute;
    opacity: 0;
    border-radius: var(--radius-sm);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero[data-motion='on'] [data-hero-cover='smena'][data-playing] .hero__cover-motion > :first-child {
      inset: 47% auto auto 36.25%;
      width: 7.5%;
      height: 7.2%;
      background: var(--accent);
      transform-origin: left center;
      animation: booking-fill 1.45s var(--ease-in-out) both;
    }

    .hero[data-motion='on'] [data-hero-cover='gran'][data-playing] .hero__cover-motion > :first-child {
      inset: 36% auto auto 26.25%;
      width: 52.5%;
      height: 0.75%;
      background: var(--accent-strong);
      transform-origin: left center;
      animation: progress-fill 1.45s var(--ease-in-out) both;
    }

    .hero[data-motion='on'] [data-hero-cover='gran'][data-playing] .hero__cover-motion > :nth-child(2) {
      inset: 73% auto auto 67.5%;
      width: 11.25%;
      height: 4.8%;
      outline: 2px solid var(--accent-strong);
      animation: queue-pulse 1.35s 0.4s var(--ease-out) both;
    }

    .hero[data-motion='on'] [data-hero-cover='ai-funnel-ecosystem'][data-playing] .hero__cover-motion > :first-child {
      width: 1.6%;
      aspect-ratio: 1;
      border-radius: 50%;
      background: var(--accent-strong);
