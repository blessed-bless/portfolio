---
import Button from './Button.astro';
import PashotFrame from './PashotFrame.astro';
import { contactLinks } from '../data/home';
import { isFilled } from '../lib/fill';
import { defaultLocale, isLocale, localizedPath, ui, type Locale } from '../i18n';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
const headline = `${t.home.heroHeadline} ${t.home.heroHeadlineAccent}`;
const telegram = isFilled(contactLinks.telegram) ? contactLinks.telegram : null;
---

<section class="hero page-pad" data-hero data-locale={locale} aria-label={headline}>
  <div class="hero__copy">
    <p class="hero__brand" data-hero-name>{t.brand}</p>
    <h1 class="hero__line" data-hero-line data-page-title aria-label={headline}>
      <span>{t.home.heroHeadline}</span>
      <span class="hero__headline-accent">{t.home.heroHeadlineAccent}</span>
    </h1>
    <p class="hero__sub" data-hero-sub>{t.home.heroSubtitle}</p>
    <div class="hero__actions">
      {
        telegram ? (
          <Button href={telegram} variant="primary" data-telegram-handoff>
            {t.home.heroCta}
          </Button>
        ) : null
      }
      <Button href={`mailto:${contactLinks.email}`} variant="ghost">{t.home.contactWrite}</Button>
      <Button href={localizedPath(locale, '/order/')} variant="link">{t.home.heroServices}</Button>
    </div>
  </div>
  <PashotFrame />
</section>

<script>
  let activeHero: HTMLElement | null = null;

  async function startHero(): Promise<void> {
    const root = document.querySelector<HTMLElement>('[data-hero]');
    if (!root || root === activeHero) return;
    activeHero = root;
    const { animateHeroIntro } = await import('../scripts/hero-split');
    if (!root.isConnected) return;
    await animateHeroIntro(root);
  }

  void startHero();
  document.addEventListener('astro:page-load', () => {
    void startHero();
  });
  document.addEventListener('astro:before-swap', () => {
    activeHero = null;
  });
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.36fr);
    align-items: start;
    gap: clamp(1.5rem, 4vw, 5rem);
    min-height: calc(100svh - var(--header-h));
    padding-top: clamp(1.25rem, 4vh, 2.75rem);
    padding-bottom: clamp(4rem, 10vh, 6rem);
    background: var(--bg);
    isolation: isolate;
  }

  .hero__copy {
    display: grid;
    align-content: center;
    min-width: 0;
    gap: var(--space-4);
    container-type: inline-size;
  }

  .hero__brand,
  .hero__line,
  .hero__sub {
    margin: 0;
  }

  .hero__brand {
    justify-self: start;
    padding-block-end: var(--space-2);
    border-bottom: var(--stroke) solid var(--accent-strong);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .hero__line {
    font-size: clamp(1.85rem, 9.4cqi, 3.15rem);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: 1.04;
    overflow-wrap: anywhere;
  }

  .hero__line > span {
    display: block;
  }

  .hero__headline-accent {
    color: var(--accent-strong);
  }

  .hero__sub {
    max-width: 32ch;
    font-size: var(--text-base);
    color: var(--fg-muted);
    line-height: var(--leading-body);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero__actions :global(.btn--link) {
    min-height: 2.75rem;
  }

  :global(.hero-char) {
    display: inline-block;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      padding-block: var(--space-6);
    }

    .hero__line {
      font-size: clamp(1.85rem, 7vw, 3.4rem);
    }

    .hero__copy {
      gap: var(--space-3);
    }
  }
</style>
