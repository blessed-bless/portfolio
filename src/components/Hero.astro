---
import { projects } from '../data/projects';

const subtitle = 'Делаю продукты от идеи до продакшена';
const role = 'Fullstack · AI';
---

<section class="hero" data-hero aria-label="Первый экран">
  <div class="hero__copy">
    <h1 class="hero__name" data-hero-name>Богдан</h1>
    <p class="hero__line" data-hero-line>{subtitle}</p>
    <div class="hero__foot hero__foot--desktop" data-hero-foot>
      <p class="hero__role mono">{role}</p>
      <a class="hero__scroll mono" href="#work" data-cursor="hover">К работам</a>
    </div>
  </div>

  <div class="hero__stage-wrap">
    <div class="hero__stage">
      <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
      <div class="hero__static" data-hero-static hidden>
        {
          projects.map((project, index) => (
            <a
              class="hero__static-card"
              href={project.hasPage ? `/work/${project.slug}` : '#work'}
              data-cursor="hover"
              style={`background-image: url(${project.cover})`}
            >
              <span class="mono">
                {String(index + 1).padStart(2, '0')} · {project.title}
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero__chrome">
      <p class="hero__counter mono" data-hero-counter>01 / 05</p>
      <p class="hero__hint mono" data-hero-hint>листайте</p>
      <p class="hero__caption mono" data-hero-caption aria-live="polite"></p>
    </div>
  </div>

  <div class="hero__foot hero__foot--mobile" data-hero-foot-mobile>
    <p class="hero__role mono">{role}</p>
    <a class="hero__scroll mono" href="#work" data-cursor="hover">К работам</a>
  </div>
</section>

<script>
  import { projects } from '../data/projects';
  import type { Project } from '../data/projects';

  let sceneTeardown: (() => void) | null = null;

  async function openProject(project: Project): Promise<void> {
    if (!project.hasPage) return;
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const { expandToWorkPage, projectPlaneScreenRect } = await import('../scripts/hero-scene');
    const from =
      (canvas && projectPlaneScreenRect(canvas)) ||
      new DOMRect(window.innerWidth * 0.35, window.innerHeight * 0.28, 480, 320);
    await expandToWorkPage(project, from);
    const { navigate } = await import('astro:transitions/client');
    navigate(`/work/${project.slug}`);
    window.setTimeout(() => {
      document.querySelectorAll('.work-expand').forEach((node) => node.remove());
    }, 900);
  }

  async function bootHero(): Promise<void> {
    const root = document.querySelector<HTMLElement>('[data-hero]');
    if (!root) return;

    sceneTeardown?.();
    sceneTeardown = null;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const caption = root.querySelector<HTMLElement>('[data-hero-caption]');
    const counter = root.querySelector<HTMLElement>('[data-hero-counter]');
    const hint = root.querySelector<HTMLElement>('[data-hero-hint]');
    const staticGrid = root.querySelector<HTMLElement>('[data-hero-static]');

    let playIntro: (() => Promise<void>) | null = null;

    if (reduce) {
      root.dataset.webgl = 'off';
      staticGrid?.removeAttribute('hidden');
      if (caption) caption.hidden = true;
      if (hint) hint.hidden = true;
    } else if (canvas) {
      const { mountHeroScene } = await import('../scripts/hero-scene');
      const handle = mountHeroScene(canvas, {
        projects,
        caption,
        counter,
        hint,
        reducedMotion: false,
        onSelect: (project) => {
          void openProject(project);
        },
      });
      if (handle) {
        root.dataset.webgl = 'on';
        sceneTeardown = handle.dispose;
        playIntro = handle.playIntro;
        staticGrid?.setAttribute('hidden', '');
      } else {
        root.dataset.webgl = 'off';
        staticGrid?.removeAttribute('hidden');
      }
    } else {
      root.dataset.webgl = 'off';
      staticGrid?.removeAttribute('hidden');
    }

    const { animateHeroIntro } = await import('../scripts/hero-split');
    await animateHeroIntro(root, {
      onCarouselEnter: async () => {
        await playIntro?.();
      },
    });
  }

  void bootHero();
  document.addEventListener('astro:page-load', () => {
    void bootHero();
  });
  document.addEventListener('astro:before-swap', () => {
    sceneTeardown?.();
    sceneTeardown = null;
  });
</script>

<style>
  .hero {
    --hero-copy-w: clamp(15rem, 32vw, 28rem);
    position: relative;
    isolation: isolate;
    height: calc(100svh - var(--header-h));
    max-height: calc(100svh - var(--header-h));
    overflow: hidden;
    background: var(--bg);
  }

  .hero__copy {
    position: relative;
    z-index: 3;
    box-sizing: border-box;
    width: var(--hero-copy-w);
    height: 100%;
    padding: clamp(1rem, 3vh, 2rem) var(--space-4) clamp(1rem, 3vh, 2rem) var(--page-pad);
    display: grid;
    align-content: center;
    gap: var(--space-4);
    pointer-events: none;
  }

  .hero__copy > * {
    pointer-events: auto;
  }

  .hero__name,
  .hero__line {
    margin: 0;
    overflow: hidden;
  }

  .hero__name {
    font-size: clamp(3rem, 2rem + 4.5vw, 7rem);
    font-weight: 750;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }

  .hero__line {
    max-width: 14ch;
    font-size: clamp(1.25rem, 1rem + 1.4vw, 2rem);
    font-weight: 560;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    color: color-mix(in srgb, var(--fg) 88%, var(--accent-strong));
  }

  .hero__stage-wrap {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 65%;
    z-index: 1;
    display: grid;
    grid-template-rows: 1fr auto;
    pointer-events: none;
    background: transparent;
  }

  .hero__stage {
    position: relative;
    min-height: 0;
    height: 100%;
    overflow: visible;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    pointer-events: auto;
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, #000 16%, #000 100%),
      linear-gradient(180deg, transparent 0%, #000 10%, #000 92%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 16%, #000 100%),
      linear-gradient(180deg, transparent 0%, #000 10%, #000 92%, transparent 100%);
    mask-composite: intersect;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--dur-4) var(--ease-out);
    touch-action: none;
  }

  .hero[data-webgl='on'] .hero__canvas[data-ready='true'] {
    opacity: 1;
  }

  .hero__chrome {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-4);
    align-items: center;
    padding: var(--space-3) var(--page-pad) clamp(1rem, 3vh, 2rem) var(--space-5);
    pointer-events: none;
    opacity: 1;
    isolation: isolate;
  }

  .hero__counter,
  .hero__hint,
  .hero__caption {
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    opacity: 1;
  }

  .hero__counter {
    color: var(--accent-strong);
  }

  .hero__hint {
    color: var(--fg-muted);
    justify-self: end;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .hero__hint[data-hidden='true'] {
    opacity: 0;
  }

  .hero__caption {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    color: var(--fg);
    overflow: hidden;
    min-height: 1.2em;
  }

  .hero__caption span:nth-child(3),
  .hero__caption span:nth-child(4) {
    color: var(--fg-muted);
  }

  .hero__caption :global(.caption-char) {
    display: inline-block;
  }

  .hero__caption span:nth-child(1),
  .hero__caption span:nth-child(2) {
    color: var(--accent-strong);
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: var(--stroke) solid var(--border);
  }

  .hero__foot--mobile {
    display: none;
  }

  .hero__role {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--fg-muted);
    text-transform: uppercase;
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.35rem 0.15rem;
    font-size: var(--text-xs);
    text-decoration: none;
    text-transform: uppercase;
    color: var(--fg);
  }

  .hero__scroll:hover {
    color: var(--accent-strong);
  }

  .hero__static {
    position: absolute;
    inset: 8% 4% 18%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    align-content: center;
    pointer-events: auto;
  }

  .hero__static[hidden] {
    display: none;
  }

  .hero__static-card {
    aspect-ratio: 4 / 3;
    display: grid;
    align-items: end;
    padding: var(--space-3);
    border: var(--stroke) solid var(--border);
    background-color: var(--bg-elevated);
    background-position: center;
    background-size: cover;
    color: var(--fg);
    text-decoration: none;
    font-size: var(--text-xs);
    box-shadow: var(--shadow-soft);
  }

  :global(.hero-char) {
    display: inline-block;
    will-change: transform, opacity;
  }

  :global(.hero-word) {
    display: inline-block;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .hero {
      display: grid;
      grid-template-rows: auto minmax(55svh, 1fr) auto auto;
      padding-inline: 0;
    }

    .hero__copy {
      width: 100%;
      height: auto;
      align-content: start;
      gap: var(--space-2);
      padding: var(--space-3) var(--page-pad) var(--space-2);
    }

    .hero__name {
      font-size: clamp(2.4rem, 10vw, 3.4rem);
    }

    .hero__line {
      max-width: 18ch;
      font-size: clamp(1.05rem, 3.8vw, 1.35rem);
    }

    .hero__foot--desktop {
      display: none;
    }

    .hero__stage-wrap {
      position: relative;
      width: 100vw;
      max-width: 100vw;
      margin-inline: calc(50% - 50vw);
      height: auto;
      min-height: 55svh;
      flex: 1 1 auto;
    }

    .hero__stage {
      min-height: 55svh;
      -webkit-mask-image: linear-gradient(
        90deg,
        transparent 0%,
        #000 5%,
        #000 95%,
        transparent 100%
      );
      -webkit-mask-composite: source-over;
      mask-image: linear-gradient(
        90deg,
        transparent 0%,
        #000 5%,
        #000 95%,
        transparent 100%
      );
      mask-composite: add;
    }

    .hero__chrome {
      padding: var(--space-2) var(--page-pad) var(--space-2);
    }

    .hero__foot--mobile {
      display: flex;
      margin: 0;
      margin-top: auto;
      padding: var(--space-3) var(--page-pad) var(--space-4);
      border-top: var(--stroke) solid var(--border);
    }

    .hero__static {
      inset: 4% var(--page-pad) 22%;
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
