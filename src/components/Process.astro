---
import { isFilled } from '../lib/fill';
import { defaultLocale, isLocale, ui, type Locale } from '../i18n';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
const processSteps = t.process;
const showTiming = processSteps.some((step) => isFilled(step.timing));
---

<section class="process page-pad" id="process" data-process data-band="ink" aria-label={t.home.processTitle}>
  <div class="process__pin" data-process-pin>
    <div class="process__intro">
      <p class="eyebrow">{t.home.processEyebrow}</p>
      <h2 class="process__title" data-scramble>{t.home.processTitle}</h2>
    </div>
    <ol class="process__list">
      {
        processSteps.map((step, index) => (
          <li class="process__step" data-process-step>
            <p class="process__num mono">{String(index + 1).padStart(2, '0')}</p>
            <h3 class="process__step-title">{step.title}</h3>
            <p class="process__step-text">{step.text}</p>
            {showTiming && isFilled(step.timing) ? (
              <p class="process__timing mono">{step.timing}</p>
            ) : null}
          </li>
        ))
      }
    </ol>
    <div class="process__meter" aria-hidden="true">
      <span data-process-bar></span>
    </div>
  </div>
</section>

<style>
  .process {
    padding-block: var(--section-gap);
    border-top: var(--stroke) solid var(--border);
  }

  .process__intro {
    margin-bottom: var(--space-6);
    max-width: 42rem;
  }

  .process__title {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .process__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .process__step {
    min-width: 0;
    padding-top: var(--space-4);
    border-top: var(--stroke) solid var(--border-strong);
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .process__step[data-current='true'] .process__num {
    color: var(--accent);
  }

  .process__num {
    margin: 0;
    color: var(--accent-strong);
    font-size: var(--text-sm);
  }

  .process__step-title {
    margin: 0;
    font-size: var(--text-md);
    font-weight: 650;
  }

  .process__step-text {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .process__timing {
    margin: var(--space-2) 0 0;
    color: var(--fg);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .process__meter {
    height: 2px;
    margin-top: var(--space-5);
    background: var(--border);
  }

  .process__meter span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0.04);
    transform-origin: left center;
  }

  @media (max-width: 900px) {
    .process__list {
      grid-template-columns: 1fr;
    }

    .process__step {
      opacity: 1;
    }
  }
</style>
