---
import { manifestLines } from '../data/home';
---

<section class="manifest page-pad" data-manifest aria-label="Манифест">
  <p class="eyebrow">Подход</p>
  <div class="manifest__text">
    {
      manifestLines.map((line) => (
        <p class="manifest__line">
          {line.split(' ').map((word) => (
            <span class="manifest__word">{word}&nbsp;</span>
          ))}
        </p>
      ))
    }
  </div>
</section>

<style>
  .manifest {
    padding-block: var(--section-gap);
    border-top: var(--stroke) solid var(--border);
  }

  .manifest__text {
    margin-top: var(--space-5);
    max-width: 22ch;
    display: grid;
    gap: var(--space-3);
  }

  .manifest__line {
    margin: 0;
    font-size: clamp(1.85rem, 1.2rem + 2.8vw, 3.6rem);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .manifest__word {
    display: inline-block;
    color: color-mix(
      in srgb,
      var(--fg) calc(var(--word-glow, 0.28) * 100%),
      var(--fg-faint)
    );
    will-change: color;
  }

  @media (min-width: 901px) {
    .manifest__text {
      max-width: 18ch;
    }
  }
</style>
