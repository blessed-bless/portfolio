---
import ProjectCover from './ProjectCover.astro';
import { getFeaturedProjects } from '../lib/work';
import type { Project } from '../lib/work-types';
import { defaultLocale, isLocale, localizedPath, ui, type Locale } from '../i18n';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
const featured: Project[] = await getFeaturedProjects(locale);
const first = featured[0];
---

<section
  class="featured page-pad"
  id="work"
  data-featured
  style={`--featured-count: ${featured.length}`}
  aria-label={t.home.featuredTitle}
>
  <div class="featured__head">
    <p class="eyebrow">{t.home.featuredEyebrow}</p>
    <h2 class="featured__title">{t.home.featuredTitle}</h2>
  </div>

  <div class="featured__scroll" data-featured-scroll>
    <div class="featured__sticky">
      <ul class="featured__list" data-featured-list>
        {
          featured.map((project, index) => (
            <li>
              <a
                class="featured__row"
                href={localizedPath(locale, `/work/${project.slug}/`)}
                data-featured-row
                data-slug={project.slug}
                data-cursor="hover"
              >
                <span class="featured__mobile-preview" aria-hidden="true">
                  <ProjectCover
                    src={project.cover}
                    transitionName={`work-cover-${project.slug}`}
                    index={index + 1}
                    title={project.title}
                  />
                </span>
                <span class="featured__num mono">{String(index + 1).padStart(2, '0')}</span>
                <span class="featured__name">{project.title}</span>
                <span class="featured__year mono">{project.year}</span>
                <span class="featured__stack mono">{project.stack}</span>
              </a>
            </li>
          ))
        }
      </ul>

      {
        first ? (
          <a
            class="featured__preview"
            data-featured-preview
            data-cover-lens
            href={localizedPath(locale, `/work/${first.slug}/`)}
            tabindex="-1"
            aria-hidden="true"
          >
            <div class="featured__preview-media" data-featured-media>
              <ProjectCover src={first.cover} index={1} title={first.title} />
            </div>
          </a>
        ) : null
      }
    </div>
  </div>
</section>

<style>
  .featured {
    position: relative;
    padding-block: var(--section-gap);
    border-top: var(--stroke) solid var(--border);
  }

  .featured__head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .featured__title {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .featured__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--stroke) solid var(--border);
  }

  .featured__row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1.6fr) 4.5rem minmax(8rem, 0.9fr);
    gap: var(--space-4);
    align-items: baseline;
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
    border-bottom: var(--stroke) solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: color var(--dur-2) var(--ease-out);
  }

  .featured__row:hover,
  .featured__row:focus-visible,
  .featured__row[data-active='true'] {
    color: var(--accent-strong);
  }

  .featured__mobile-preview {
    display: none;
  }

  .featured__num {
    color: var(--accent-strong);
    font-size: var(--text-sm);
  }

  .featured__name {
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.75rem);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .featured__year,
  .featured__stack {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .featured__year {
    text-align: right;
  }

  .featured__preview {
    display: none;
    aspect-ratio: 16 / 10;
    border: var(--stroke) solid var(--border);
    background: var(--bg-elevated);
    overflow: hidden;
    text-decoration: none;
  }

  .featured__preview-media,
  .featured__preview-media :global(.project-cover-wrap) {
    width: 100%;
    height: 100%;
  }

  @media (min-width: 901px) {
    html[data-perf='high'] .featured__sticky,
    html[data-perf='mid'] .featured__sticky {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
      gap: clamp(1.25rem, 3vw, 3rem);
      align-items: start;
    }

    html[data-perf='high'] .featured__preview,
    html[data-perf='mid'] .featured__preview {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 1rem);
      align-self: start;
    }
  }

  @media (min-width: 901px) and (pointer: fine) {
    html[data-perf='high'] .featured__scroll {
      height: calc(100svh + (var(--featured-count, 1) - 1) * 38svh);
    }

    html[data-perf='high'] .featured__sticky {
      position: sticky;
      top: var(--header-h);
      height: calc(100svh - var(--header-h));
      align-items: center;
      overflow: hidden;
    }

    html[data-perf='high'] .featured__preview {
      position: relative;
      top: auto;
    }

    html[data-perf='high'] .featured__list {
      border-top: 0;
    }
  }

  @media (max-width: 900px) {
    .featured__row {
      grid-template-columns: 2.5rem 1fr;
      grid-template-areas:
        'preview preview'
        'num name'
        'year stack';
      gap: var(--space-2) var(--space-3);
      padding-block: var(--space-5);
    }

    .featured__mobile-preview {
      display: block;
      grid-area: preview;
      aspect-ratio: 16 / 10;
      margin-bottom: var(--space-2);
      border: var(--stroke) solid var(--border);
      background: var(--bg-elevated) center / cover no-repeat;
    }

    .featured__num {
      grid-area: num;
    }

    .featured__name {
      grid-area: name;
      font-size: clamp(1.35rem, 5vw, 1.85rem);
    }

    .featured__year {
      grid-area: year;
    }

    .featured__stack {
      grid-area: stack;
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured__scroll {
      height: auto !important;
    }

    .featured__sticky {
      position: static !important;
      height: auto !important;
      display: block !important;
      overflow: visible !important;
    }

    .featured__preview {
      display: none !important;
    }
  }
</style>
