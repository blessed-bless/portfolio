---
import Button from './Button.astro';
import ProjectCover from './ProjectCover.astro';
import { featuredWorkCopy } from '../data/featured-work';
import { getFeaturedProjects, workStatusLabel } from '../lib/work';
import { defaultLocale, isLocale, localizedPath, ui } from '../i18n';

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
const featured = await getFeaturedProjects(locale);
const catalog = locale === 'en' ? 'All projects' : 'Все проекты';
const readCase = locale === 'en' ? 'Read the case' : 'Читать кейс';
---

<section class="featured page-pad" id="work" data-featured aria-labelledby="featured-heading">
  <header class="featured__head">
    <h2 class="featured__title" id="featured-heading">{t.home.featuredTitle}</h2>
    <Button href={localizedPath(locale, '/work/')} variant="ghost">{catalog} <span aria-hidden="true">↗</span></Button>
  </header>

  <div class="featured__grid">
    {featured.map((project, index) => {
      const copy = featuredWorkCopy[project.slug]?.[locale];
      const href = localizedPath(locale, `/work/${project.slug}/`);
      const demoHref = project.links.live ?? `${href}#demo`;
      return (
        <article class:list={['featured__case', { 'featured__case--lead': index === 0 }]} aria-labelledby={`featured-${project.slug}`}>
          <a class="featured__cover" href={href} aria-label={project.title} data-cursor="hover">
            <ProjectCover src={project.cover} transitionName={`work-cover-${project.slug}`} />
          </a>
          <div class="featured__body">
            <p class="featured__type mono">{copy?.category ?? project.role}</p>
            <h3 class="featured__name" id={`featured-${project.slug}`}>{project.title}</h3>
            <p class="featured__description">{copy?.scenario ?? project.summary}</p>
            <p class="featured__status">{workStatusLabel(project.status, project.origin, t.workOrigin)} · {project.role}</p>
            <div class="featured__links">
              {copy && (
                <Button
                  href={demoHref}
                  variant={index === 0 ? 'primary' : 'ghost'}
                  data-demo-start={project.links.live ? undefined : project.slug}
                  data-demo-from={project.links.live ? undefined : 'featured'}
                >
                  {copy.action} <span aria-hidden="true">{project.links.live ? '↗' : '→'}</span>
                </Button>
              )}
              <Button href={href} variant="ghost">{readCase}</Button>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .featured {
    padding-block: var(--section-gap);
    border-top: var(--stroke) solid var(--border);
  }

  .featured__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .featured__title {
    margin: 0;
    max-width: 15ch;
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  .featured__grid {
    display: grid;
    gap: var(--space-4);
  }

  .featured__case {
    display: grid;
    align-content: start;
    min-width: 0;
    border-top: var(--stroke) solid var(--border-strong);
    background: var(--bg-elevated);
  }

  .featured__case--lead {
    border-top-color: var(--accent-strong);
  }

  .featured__cover {
    display: block;
    position: relative;
    overflow: hidden;
    min-width: 0;
    background: var(--bg-elevated);
  }

  .featured__cover::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    border: var(--stroke) solid var(--border);
  }

  .featured__cover:focus-visible {
    outline-offset: -3px;
    z-index: 1;
  }

  .featured__body {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-2);
    padding: clamp(1rem, 2.3vw, 2rem);
  }

  .featured__body p {
    margin: 0;
  }

  .featured__type {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--accent-strong);
    text-transform: uppercase;
  }

  .featured__name {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    overflow-wrap: anywhere;
  }

  .featured__case--lead .featured__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .featured__description {
    max-width: 44ch;
    color: var(--fg);
  }

  .featured__status {
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }

  .featured__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  @media (min-width: 720px) {
    .featured__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .featured__case--lead {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  @media (min-width: 1100px) {
    .featured__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }

    .featured__case--lead {
      grid-column: 1;
      grid-row: span 2;
      grid-template-columns: minmax(0, 1fr);
    }

    .featured__case:not(.featured__case--lead) {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-content: stretch;
    }

    .featured__case:not(.featured__case--lead) .featured__cover :global(.project-cover-wrap) {
      height: 100%;
    }

    .featured__case:not(.featured__case--lead) .featured__cover :global(.project-cover) {
      height: 100%;
      object-fit: contain;
      background: var(--bg-elevated);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      :global(html:not([data-perf='low'])) .featured__cover:not(:focus-visible) {
        animation: featured-cover-entry linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 82%;
      }
    }
  }

  @keyframes featured-cover-entry {
    from {
      clip-path: inset(12% 0 8% 0);
      translate: 0 0.8rem;
    }

    to {
      clip-path: inset(0);
      translate: 0 0;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(html:not([data-perf='low'])) .featured__cover :global(.project-cover-wrap) {
      transition: scale var(--dur-3) var(--ease-out);
    }

    :global(html:not([data-perf='low'])) .featured__cover:hover :global(.project-cover-wrap) {
      scale: 1.035;
    }
  }
</style>
