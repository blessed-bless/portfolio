---
import { stackRowA, stackRowB } from '../data/home';

const rowA = [...stackRowA, ...stackRowA];
const rowB = [...stackRowB, ...stackRowB];
---

<section class="stack page-pad" data-stack aria-label="Стек">
  <div class="stack__head">
    <p class="eyebrow">Инструменты</p>
    <h2 class="stack__title">Стек</h2>
  </div>

  <div class="stack__rails" aria-hidden="true">
    <div class="stack__row stack__row--left" data-marquee-row>
      <div class="stack__track">
        {rowA.map((item) => <span class="stack__item mono">{item}</span>)}
      </div>
    </div>
    <div class="stack__row stack__row--right" data-marquee-row>
      <div class="stack__track">
        {rowB.map((item) => <span class="stack__item mono">{item}</span>)}
      </div>
    </div>
  </div>

  <ul class="stack__sr sr-only">
    {[...stackRowA, ...stackRowB].map((item) => <li>{item}</li>)}
  </ul>
</section>

<style>
  .stack {
    padding-block: var(--section-gap);
    border-top: var(--stroke) solid var(--border);
    overflow: hidden;
  }

  .stack__head {
    margin-bottom: var(--space-6);
  }

  .stack__title {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
  }

  .stack__rails {
    display: grid;
    gap: var(--space-4);
  }

  .stack__row {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .stack__track {
    display: flex;
    width: max-content;
    gap: var(--space-7);
    animation: stack-marquee 42s linear infinite;
  }

  .stack__row--right .stack__track {
    animation-direction: reverse;
    animation-duration: 48s;
  }

  .stack[data-paused='true'] .stack__track {
    animation-play-state: paused;
  }

  .stack__item {
    font-size: clamp(1rem, 0.9rem + 0.6vw, 1.35rem);
    color: var(--fg-muted);
    text-transform: uppercase;
    white-space: nowrap;
  }

  @keyframes stack-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack__track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      gap: var(--space-3) var(--space-5);
    }

    .stack__row {
      mask-image: none;
    }
  }
</style>
