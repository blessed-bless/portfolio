---
import ThemeToggle from './ThemeToggle.astro';
import { hasPublishedNotes } from '../lib/notes';

const pathname = Astro.url.pathname;
const showNotes = await hasPublishedNotes();

const links = [
  { href: '/', label: 'Главная' },
  { href: '/work', label: 'Работы' },
  { href: '/about', label: 'Обо мне' },
  ...(showNotes ? [{ href: '/notes', label: 'Заметки' }] : []),
  { href: '/#contact', label: 'Контакт' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  if (href.startsWith('/#')) return false;
  if (href === '/work') return pathname === '/work' || pathname.startsWith('/work/');
  if (href === '/notes') return pathname === '/notes' || pathname.startsWith('/notes/');
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header page-pad">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" data-cursor="hover">
      <span class="site-header__mark" aria-hidden="true"></span>
      <span class="site-header__name">Богдан</span>
    </a>

    <nav class="site-header__nav" aria-label="Основная">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[{ 'is-active': isActive(link.href) }]}
                data-cursor="hover"
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__aside">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    border-bottom: var(--stroke) solid var(--border);
    background: var(--bg);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    width: min(100%, var(--grid-max));
    margin-inline: auto;
    gap: var(--space-5);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
  }

  .site-header__brand:hover {
    color: var(--fg);
  }

  .site-header__mark {
    width: 0.7rem;
    height: 0.7rem;
    background: var(--accent);
  }

  .site-header__name {
    font-size: var(--text-sm);
  }

  .site-header__nav {
    margin-inline: auto 0;
  }

  .site-header__nav ul {
    display: flex;
    flex-wrap: nowrap;
    gap: clamp(0.9rem, 2vw, 1.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-decoration: none;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .site-header__nav a:hover,
  .site-header__nav a.is-active {
    color: var(--fg);
  }

  .site-header__aside {
    display: flex;
    flex-shrink: 0;
  }

  @media (max-width: 720px) {
    .site-header__nav {
      display: none;
    }
  }
</style>
