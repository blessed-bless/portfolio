---
import ThemeToggle from './ThemeToggle.astro';
import BrandMark from './BrandMark.astro';
import Button from './Button.astro';
import { contactLinks, telegramChannel } from '../data/home';
import { isFilled } from '../lib/fill';
import { hasPublishedNotes } from '../lib/notes';
import { withTrailingSlash } from '../lib/paths';
import {
  defaultLocale,
  isLocale,
  localizedPath,
  stripLocalePrefix,
  switchLocalePath,
  ui,
  type Locale,
} from '../i18n';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
const pathname = Astro.url.pathname;
const bare = stripLocalePrefix(pathname);
const showNotes = locale === 'ru' && (await hasPublishedNotes());
const telegram = isFilled(contactLinks.telegram) ? contactLinks.telegram : null;
const email = isFilled(contactLinks.email) ? contactLinks.email : null;
const otherLocale: Locale = locale === 'ru' ? 'en' : 'ru';
const localeSwitchHref = switchLocalePath(pathname, otherLocale);

const links = [
  { href: localizedPath(locale, '/'), label: t.nav.home },
  { href: localizedPath(locale, '/work/'), label: t.nav.work },
  { href: localizedPath(locale, '/about/'), label: t.nav.about },
  ...(showNotes ? [{ href: localizedPath(locale, '/notes/'), label: t.nav.notes }] : []),
  { href: localizedPath(locale, '/order/'), label: t.nav.order },
];

function isActive(href: string): boolean {
  const pathOnly = href.split('#')[0] ?? href;
  if (pathOnly === '/' || pathOnly === '/en/') {
    return bare === '/' || bare === '';
  }
  const target = stripLocalePrefix(pathOnly).replace(/\/$/, '');
  const current = bare.replace(/\/$/, '') || '/';
  if (target === '/work') return current === '/work' || current.startsWith('/work/');
  if (target === '/notes') return current === '/notes' || current.startsWith('/notes/');
  return current === target || current.startsWith(`${target}/`);
}
---

<header class="site-header page-pad" data-site-header>
  <div class="site-header__inner">
    <a class="site-header__brand" href={localizedPath(locale, '/')} data-cursor="hover">
      <BrandMark class="site-header__mark" size={24} />
      <span class="site-header__name">{t.brand}</span>
    </a>

    <nav class="site-header__nav" aria-label={locale === 'en' ? 'Primary' : 'Основная'} data-nav-desktop>
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[{ 'is-active': isActive(link.href) }]}
                data-cursor="hover"
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__aside">
      {
        telegram ? (
          <Button href={telegram} variant="primary" class="site-header__discuss" data-telegram-handoff>
            <svg class="tg-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path fill="currentColor" d="M21.5 4.4 2.7 11.6c-.8.3-.8.8-.1 1l4.8 1.5 1.9 5.8c.2.6.1.9.8.9.4 0 .6-.2.9-.4l2.6-2.5 4.8 3.5c.8.5 1.4.2 1.6-.8l3-14.7c.3-1.3-.5-1.9-1.5-1.5Zm-12 9.2 8.8-5.5c.4-.3.8-.1.5.2l-7.6 6.9-.3 3.2-1.4-4.8Z" />
            </svg>
            <span class="site-header__discuss-label">{t.header.discuss}</span>
          </Button>
        ) : null
      }
      <a
        class="site-header__locale mono"
        href={localeSwitchHref}
        data-cursor="hover"
        hreflang={otherLocale}
        lang={otherLocale}
      >
        {otherLocale.toUpperCase()}
      </a>
      <button
        type="button"
        class="site-header__cmdk mono"
        data-cmdk-open
        data-cursor="hover"
        aria-label={`${t.header.cmdk} ${t.header.cmdkShort}`}
        title={t.header.cmdk}
      >
        <span class="site-header__cmdk-label">{t.header.cmdkShort}</span>
      </button>
      <ThemeToggle lightLabel={t.header.themeLight} darkLabel={t.header.themeDark} />
      <button
        type="button"
        class="site-header__menu-btn"
        data-nav-toggle
        data-cursor="hover"
        data-label-open={t.header.openMenu}
        data-label-close={t.header.closeMenu}
        aria-expanded="false"
        aria-controls="site-nav-panel"
        aria-label={t.header.openMenu}
      >
        <span class="site-header__menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <div
    id="site-nav-panel"
    class="site-header__panel"
    data-nav-panel
    hidden
    inert
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label={t.header.menuLabel}
  >
    <nav class="site-header__panel-nav" aria-label={t.header.mobileNav}>
      <ul>
        {
          links.map((link) => (
            <li data-nav-item>
              <a
                href={link.href}
                class:list={[{ 'is-active': isActive(link.href) }]}
                data-cursor="hover"
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-header__panel-foot" data-nav-item>
      <button type="button" class="site-header__panel-link" data-cmdk-open data-cursor="hover">
        {t.header.cmdk}
      </button>
      <a class="site-header__panel-link" href={localeSwitchHref} data-cursor="hover" hreflang={otherLocale}>
        {otherLocale.toUpperCase()}
      </a>
      <a
        class="site-header__panel-link"
        href={telegramChannel.href}
        target="_blank"
        rel="noopener noreferrer"
        data-cursor="hover"
        data-tg-channel
      >
        {t.header.channel}
      </a>
      {
        email ? (
          <a class="site-header__panel-link" href={`mailto:${email}`} data-cursor="hover">
            {email}
          </a>
        ) : null
      }
      {
        telegram ? (
          <a class="site-header__panel-link" href={telegram} data-cursor="hover" data-telegram-handoff>
            {locale === 'en' ? 'Message Bogdan on Telegram' : 'Написать Богдану в Telegram'}
          </a>
        ) : null
      }
    </div>
  </div>
</header>

<script>
  import { mountMobileNav } from '../scripts/nav-menu';

  let teardown: (() => void) | null = null;

  const boot = () => {
    teardown?.();
    teardown = null;
    const root = document.querySelector<HTMLElement>('[data-site-header]');
    if (root) teardown = mountMobileNav(root);
  };

  boot();
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    border-bottom: var(--stroke) solid var(--border);
    background: var(--bg);
  }

  .site-header__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    width: min(100%, var(--grid-max));
    margin-inline: auto;
    gap: var(--space-5);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
  }

  .site-header__brand:hover {
    color: var(--fg);
  }

  .site-header__mark {
    display: block;
    width: 24px;
    height: 24px;
    flex: none;
    color: var(--fg);
  }

  .site-header__brand:hover :global(.brand-mark__caret) {
    animation: site-header-caret-blink 1s steps(1, end) infinite;
  }

  @keyframes site-header-caret-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__brand:hover :global(.brand-mark__caret) {
      animation: none;
    }

    .site-header__panel [data-nav-item] {
      animation: none;
      transform: none;
    }
  }

  :global(html[data-perf='low'] .site-header__brand:hover .brand-mark__caret) {
    animation: none;
  }

  .site-header__name {
    font-size: var(--text-sm);
  }

  .site-header :global(.site-header__discuss) {
    min-height: 44px;
    padding-inline: 0.9rem;
    gap: 0.45rem;
  }

  .tg-icon {
    display: block;
    flex: none;
  }

  .site-header__nav {
    margin-inline: auto 0;
  }

  .site-header__nav ul {
    display: flex;
    flex-wrap: nowrap;
    gap: clamp(0.9rem, 2vw, 1.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-decoration: none;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .site-header__nav a:hover,
  .site-header__nav a.is-active {
    color: var(--fg);
  }

  .site-header__aside {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-2);
  }

  .site-header__locale {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 2.5rem;
    padding: 0 0.45rem;
    border: var(--stroke) solid var(--border);
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--text-xs);
  }

  .site-header__locale:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }


  .site-header__cmdk {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    padding: 0 0.55rem;
    border: var(--stroke) solid var(--border);
    background: var(--bg-elevated);
    color: var(--fg-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    cursor: pointer;
  }

  .site-header__cmdk:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }

  .site-header__menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    padding: 0;
    border: var(--stroke) solid var(--border);
    background: var(--bg-elevated);
    color: var(--fg);
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .site-header__menu-icon {
    position: relative;
    display: block;
    width: 18px;
    height: 18px;
  }

  .site-header__menu-icon > span {
    position: absolute;
    inset: 8px 0 auto;
    height: 2px;
    background: currentColor;
    transition: transform var(--dur-2) var(--ease-out), opacity var(--dur-1) var(--ease-out);
  }

  .site-header__menu-icon > span:first-child {
    transform: translateY(-6px);
  }

  .site-header__menu-icon > span:last-child {
    transform: translateY(6px);
  }

  .site-header[data-nav-open='true'] .site-header__menu-icon > span:first-child {
    transform: rotate(45deg);
  }

  .site-header[data-nav-open='true'] .site-header__menu-icon > span:nth-child(2) {
    opacity: 0;
  }

  .site-header[data-nav-open='true'] .site-header__menu-icon > span:last-child {
    transform: rotate(-45deg);
  }

  :global(html[data-perf='low']) .site-header__menu-icon > span {
    transition: none;
  }

  .site-header__panel {
    position: fixed;
    inset: 0;
    z-index: 39;
    background:
      radial-gradient(60% 40% at 100% 0%, rgb(139 92 246 / 0.28), transparent 55%),
      var(--bg);
    padding: calc(var(--header-h) + 1.5rem) var(--page-pad) var(--space-8);
    overflow: auto;
  }

  .site-header__panel [data-nav-item] {
    transform: translateY(18px);
  }

  .site-header[data-nav-open='true'] .site-header__panel [data-nav-item] {
    animation: nav-item-in 0.55s var(--ease-out) both;
  }

  .site-header[data-nav-open='true'] .site-header__panel [data-nav-item]:nth-child(2) { animation-delay: 0.05s; }
  .site-header[data-nav-open='true'] .site-header__panel [data-nav-item]:nth-child(3) { animation-delay: 0.1s; }
  .site-header[data-nav-open='true'] .site-header__panel [data-nav-item]:nth-child(4) { animation-delay: 0.15s; }
  .site-header[data-nav-open='true'] .site-header__panel [data-nav-item]:nth-child(5) { animation-delay: 0.2s; }

  @keyframes nav-item-in {
    from { opacity: 0; transform: translateY(22px); }
    to { opacity: 1; transform: none; }
  }

  .site-header__panel[hidden] {
    display: none;
  }

  .site-header__panel-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .site-header__panel-nav a {
    display: flex;
    align-items: center;
    min-height: 52px;
    font-size: clamp(1.8rem, 6vw, 2.6rem);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
    color: var(--fg);
    border-bottom: var(--stroke) solid var(--border);
  }

  .site-header__panel-nav a.is-active {
    color: var(--accent-strong);
  }

  .site-header__panel-foot {
    margin-top: var(--space-7);
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .site-header__panel-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--fg-muted);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
  }

  .site-header__panel-link:hover {
    color: var(--accent-strong);
  }

  body.nav-lock {
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .site-header__discuss-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .site-header :global(.site-header__discuss) {
      width: 44px;
      padding: 0;
    }
  }

  @media (max-width: 768px) {
    .site-header__nav {
      display: none;
    }

    .site-header__cmdk {
      display: none;
    }

    .site-header__menu-btn {
      display: inline-flex;
    }
  }
</style>
