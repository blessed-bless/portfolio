---
import { defaultLocale, isLocale, ui, type Locale } from '../i18n';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
---

<section class="whoami page-pad" id="whoami" aria-label={t.home.whoamiTitle}>
  <div class="whoami__intro">
    <p class="eyebrow">{t.home.whoamiEyebrow}</p>
    <h2 class="whoami__title" data-scramble>{t.home.whoamiTitle}</h2>
  </div>
  <div class="whoami__copy">
    {t.home.whoami.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>

<style>
  .whoami {
    padding-block: var(--section-gap);
    border-top: var(--stroke) solid var(--border);
  }

  .whoami__intro {
    margin-bottom: var(--space-5);
    max-width: 42rem;
  }

  .whoami__title {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .whoami__copy {
    display: grid;
    gap: var(--space-4);
    max-width: 42rem;
  }

  .whoami__copy p {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--text-md);
    line-height: var(--leading-body);
  }
</style>
