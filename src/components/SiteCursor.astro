<div
  class="site-cursor"
  data-site-cursor
  hidden
  data-visible="false"
  data-hover="false"
  data-on-control="false"
  data-open="false"
  aria-hidden="true"
  transition:persist="site-cursor"
>
  <span class="site-cursor__dot" data-cursor-dot></span>
  <span class="site-cursor__ring" data-cursor-ring></span>
  <span class="site-cursor__label mono" data-cursor-label></span>
</div>

<style>
  .site-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    z-index: 90;
    pointer-events: none;
    opacity: 0;
    overflow: visible;
    contain: layout style;
  }

  .site-cursor[data-visible='true'] {
    opacity: 1;
  }

  .site-cursor[data-visible='true'] .site-cursor__dot,
  .site-cursor[data-visible='true'] .site-cursor__ring {
    will-change: transform;
  }

  html[data-perf='mid'] .site-cursor,
  html[data-perf='low'] .site-cursor {
    display: none !important;
  }

  .site-cursor__dot,
  .site-cursor__ring {
    position: fixed;
    top: 0;
    left: 0;
    border-radius: 50%;
    transform: translate3d(-100px, -100px, 0);
    backface-visibility: hidden;
    transition: none !important;
  }

  .site-cursor__dot {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--cursor-fill);
  }

  .site-cursor__ring {
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border: 1px solid color-mix(in srgb, var(--cursor-fill) 55%, transparent);
    /* No transition on transform — lerp runs in rAF. */
  }

  .site-cursor[data-hover='true'] .site-cursor__ring {
    border-color: var(--accent);
  }

  .site-cursor[data-on-control='true'] .site-cursor__dot {
    opacity: 0;
  }

  .site-cursor__label {
    position: fixed;
    top: 0;
    left: 0;
    padding: 0.42rem 0.72rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: translate3d(-100px, -100px, 0) scale(0.55);
  }

  .site-cursor[data-open='true'] .site-cursor__ring,
  .site-cursor[data-open='true'] .site-cursor__dot {
    opacity: 0;
  }

  .site-cursor[data-open='true'] .site-cursor__label {
    opacity: 1;
  }

  @media (pointer: coarse), (hover: none), (prefers-reduced-motion: reduce) {
    .site-cursor {
      display: none !important;
    }
  }
</style>
