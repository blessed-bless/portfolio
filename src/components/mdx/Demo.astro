---
import { defaultLocale, isLocale, ui, type Locale } from '../../i18n';

interface Props {
  id: 'priemnaya' | 'smena' | 'fleetkit' | 'crawlnet' | 'ai-funnel-ecosystem' | 'shipcrew';
}

const { id } = Astro.props;
const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
---

<section class="case-demo" id="demo" data-case-demo={id} aria-label={t.demo.ariaLabel}>
  <header class="case-demo__head">
    <h2 class="case-demo__title">{t.demo.tryTitle}</h2>
    <p class="case-demo__badge mono">{t.demo.tryBadge}</p>
  </header>
  <div class="case-demo__stage" data-demo-mount>
    <p class="case-demo__loading mono">{t.demo.loading}</p>
  </div>
</section>

<style is:global>
  .case-demo {
    margin: var(--space-7) 0;
    padding: var(--space-5);
    border: var(--stroke) solid var(--border);
    background: var(--bg-elevated);
    display: grid;
    gap: var(--space-4);
    min-width: 0;
    max-width: 100%;
    contain: layout paint;
    isolation: isolate;
  }

  html[data-perf='low'] .case-demo {
    animation: none !important;
  }

  html[data-perf='low'] .case-demo [data-demo-decor],
  html[data-perf='low'] .case-demo .demo-decor {
    display: none !important;
  }

  .case-demo__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: baseline;
    justify-content: space-between;
  }

  .case-demo__title {
    margin: 0;
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
  }

  .case-demo__badge {
    margin: 0;
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .case-demo__stage {
    min-height: 12rem;
  }

  .case-demo__loading {
    margin: 0;
    color: var(--fg-faint);
    font-size: var(--text-xs);
  }

  .demo-ui {
    display: grid;
    gap: var(--space-4);
  }

  .demo-ui__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .demo-ui__label {
    margin: 0;
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--fg-muted);
    font-family: var(--font-mono);
  }

  .demo-ui__btn {
    min-height: 44px;
    padding: 0.4rem 0.85rem;
    border: var(--stroke) solid var(--border);
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .demo-ui__btn:hover,
  .demo-ui__btn:focus-visible {
    border-color: var(--border-strong);
    color: var(--accent-strong);
  }

  .demo-ui__btn[aria-pressed='true'],
  .demo-ui__btn.is-active {
    background: var(--bg);
    border-color: var(--border-strong);
  }

  .demo-ui__btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .demo-ui__btn--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .demo-ui__select,
  .demo-ui__input {
    min-height: 44px;
    padding: 0.35rem 0.7rem;
    border: var(--stroke) solid var(--border);
    background: var(--bg);
    color: var(--fg);
    font: inherit;
    font-size: var(--text-sm);
    max-width: 100%;
  }

  .demo-ui__panel {
    border: var(--stroke) solid var(--border);
    background: var(--bg);
    padding: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }

  .demo-ui__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .demo-ui__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-3);
    border: var(--stroke) solid var(--border);
    font-size: var(--text-sm);
  }

  .demo-ui__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    text-transform: uppercase;
  }

  .demo-ui__status {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .demo-ui__status[data-tone='ok'] {
    color: var(--ok);
  }

  .demo-ui__status[data-tone='warn'] {
    color: var(--accent-strong);
  }

  .demo-ui__status[data-tone='danger'] {
    color: var(--danger);
  }

  .demo-ui__log {
    margin: 0;
    max-height: 14rem;
    overflow: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--fg-muted);
    white-space: pre-wrap;
  }

  .demo-ui__chat {
    display: grid;
    gap: var(--space-2);
    max-height: 16rem;
    overflow: auto;
  }

  .demo-ui__bubble {
    max-width: 92%;
    padding: var(--space-3);
    border: var(--stroke) solid var(--border);
    font-size: var(--text-sm);
  }

  .demo-ui__bubble[data-from='bot'] {
    justify-self: start;
    background: var(--bg-elevated);
  }

  .demo-ui__bubble[data-from='user'] {
    justify-self: end;
    border-color: var(--border-strong);
  }

  .demo-ui__graph {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: var(--stroke) solid var(--border);
    background: var(--bg-elevated);
  }

  .demo-ui {
    min-width: 0;
    max-width: 100%;
  }

  .demo-ui__footer {
    margin-top: var(--space-3);
    padding-top: var(--space-4);
    border-top: var(--stroke) solid var(--border);
  }

  a.demo-ui__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .demo-ui__table-wrap {
    overflow-x: auto;
    max-width: 100%;
  }

  .demo-ui__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-xs);
  }

  .demo-ui__table th,
  .demo-ui__table td {
    border-bottom: var(--stroke) solid var(--border);
    padding: 0.45rem 0.5rem;
    text-align: left;
  }

  .smena-demo {
    justify-items: center;
  }

  .smena-demo__phone {
    width: min(100%, 22rem);
    display: grid;
    gap: var(--space-3);
    padding: var(--space-3);
    border: var(--stroke) solid var(--border-strong);
    background: var(--bg);
    min-width: 0;
  }

  .smena-demo__chrome {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .smena-demo__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .smena-demo__title {
    margin: 0;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--fg-muted);
    text-transform: uppercase;
  }

  .smena-demo__day {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    min-height: 18rem;
    border: var(--stroke) solid var(--border);
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .smena-demo__rail {
    display: grid;
    grid-template-rows: repeat(10, 1fr);
    padding: 0.35rem 0.25rem;
    border-right: var(--stroke) solid var(--border);
    color: var(--fg-faint);
    font-size: 0.65rem;
    font-family: var(--font-mono);
  }

  .smena-demo__board {
    position: relative;
    min-height: 18rem;
  }

  .smena-demo__visit,
  .smena-demo__gap {
    position: absolute;
    left: 0.35rem;
    right: 0.35rem;
    display: grid;
    align-content: start;
    gap: 0.15rem;
    padding: 0.35rem 0.45rem;
    text-align: left;
    font: inherit;
    border: var(--stroke) solid var(--border);
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
    overflow: hidden;
  }

  .smena-demo__visit[data-status='done'] {
    opacity: 0.55;
  }

  .smena-demo__visit[data-status='arrived'] {
    border-color: var(--accent);
  }

  .smena-demo__visit[aria-pressed='true'] {
    border-color: var(--border-strong);
    background: color-mix(in srgb, var(--accent) 16%, var(--bg));
  }

  .smena-demo__visit strong {
    font-size: var(--text-xs);
  }

  .smena-demo__visit span,
  .smena-demo__visit em {
    font-size: 0.65rem;
    color: var(--fg-muted);
    font-style: normal;
  }

  .smena-demo__gap {
    border-style: dashed;
    color: var(--fg-muted);
    font-size: 0.7rem;
    font-family: var(--font-mono);
    background: transparent;
  }

  .smena-demo__actions {
    flex-wrap: wrap;
  }

  .smena-demo__share {
    margin: 0;
    padding: var(--space-3);
    border: var(--stroke) solid var(--border);
    background: var(--bg-elevated);
    font-size: var(--text-xs);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  @media (prefers-reduced-motion: reduce) {
    .case-demo * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
