---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="mdx-figure">
  <Image class="mdx-figure__img" src={src} alt={alt} widths={[480, 800, 1200].filter((width) => width < src.width).concat(src.width)} sizes="(max-width: 800px) 92vw, 760px" loading="lazy" decoding="async" />
  {caption ? <figcaption class="mdx-figure__caption mono">{caption}</figcaption> : null}
</figure>

<style>
  .mdx-figure {
    margin: var(--space-6) 0;
  }

  .mdx-figure__img {
    width: 100%;
    border: var(--stroke) solid #2A2438;
    background: var(--bg-elevated);
  }

  .mdx-figure__caption {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }
</style>
