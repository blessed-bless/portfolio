---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  device: 'browser' | 'phone';
}

const { src, alt, caption, device } = Astro.props;
const cap = device === 'phone' ? 800 : 1600;
const widths = [400, 800, 1200, 1600, src.width]
  .filter((width) => width <= src.width && width <= cap)
  .filter((width, index, list) => list.indexOf(width) === index)
  .sort((a, b) => a - b);
const sizes = device === 'phone' ? '(max-width: 800px) 78vw, 280px' : '(max-width: 800px) 92vw, 720px';
---

<figure class:list={['shot', `shot--${device}`]}>
  <div class="shot__device">
    <div class="shot__chrome" aria-hidden="true">
      <span class="shot__dots"><span></span><span></span><span></span></span>
    </div>
    <Picture
      class="shot__img"
      src={src}
      alt={alt}
      widths={widths.length ? widths : [src.width]}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      loading="lazy"
      decoding="async"
    />
  </div>
  {caption ? <figcaption class="shot__caption mono">{caption}</figcaption> : null}
</figure>

<style>
  .shot {
    margin: var(--space-6) 0;
  }

  .shot--phone {
    display: grid;
    justify-items: center;
  }

  .shot__device {
    width: 100%;
    overflow: hidden;
    border: var(--stroke) solid var(--border-strong);
    border-radius: 10px;
    background: var(--bg-elevated);
  }

  .shot--phone .shot__device {
    width: min(100%, 17.5rem);
  }

  .shot__chrome {
    display: flex;
    align-items: center;
    height: 2rem;
    padding: 0 0.75rem;
    border-bottom: var(--stroke) solid var(--border);
  }

  .shot__dots {
    display: flex;
    gap: 5px;
  }

  .shot__dots span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .shot__dots span:nth-child(n + 2) {
    opacity: 0.45;
  }

  .shot__img {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot__caption {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .shot--phone .shot__caption {
    width: min(100%, 17.5rem);
  }
</style>
