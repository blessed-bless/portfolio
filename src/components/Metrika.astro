---
import { METRIKA_ID } from '../lib/metrika';

const enabled = import.meta.env.PROD;
const pixelSrc = `https://mc.yandex.ru/watch/${METRIKA_ID}`;
---

{
  enabled ? (
    <>
      <script is:inline set:html={`
(function () {
  var host = location.hostname;
  if (host !== 'dubstepmolitva.ru' && host !== 'www.dubstepmolitva.ru') return;
  var counterId = ${METRIKA_ID};

  (function (m, e, t, r, i, k, a) {
    m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
    m[i].l = 1 * new Date();
    for (var j = 0; j < document.scripts.length; j++) {
      if (document.scripts[j].src === r) return;
    }
    k = e.createElement(t);
    a = e.getElementsByTagName(t)[0];
    k.async = 1;
    k.src = r;
    a.parentNode.insertBefore(k, a);
  })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

  ym(counterId, 'init', {
    ssr: true,
    webvisor: true,
    clickmap: true,
    accurateTrackBounce: true,
    trackLinks: true
  });
})();
`} />
      <noscript>
        <div>
          <img src={pixelSrc} style="position:absolute; left:-9999px;" alt="" />
        </div>
      </noscript>
    </>
  ) : null
}
