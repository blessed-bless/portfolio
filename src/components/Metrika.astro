---
import { METRIKA_ID } from '../lib/metrika';

const enabled = import.meta.env.PROD;
const pixelSrc = `https://mc.yandex.ru/watch/${METRIKA_ID}`;
---

{
  enabled ? (
    <div transition:persist="metrika" data-metrika-root>
      <script is:inline set:html={`
(function () {
  var host = location.hostname;
  if (host !== 'dubstepmolitva.ru' && host !== 'www.dubstepmolitva.ru') return;
  var counterId = ${METRIKA_ID};

  // Queue starts with init so early reachGoal/hit land after it, not before.
  window.ym = window.ym || function () { (ym.a = ym.a || []).push(arguments); };
  if (!ym.l) ym.l = 1 * new Date();

  if (!window.__ymPortfolioInit) {
    window.__ymPortfolioInit = true;
    ym(counterId, 'init', {
      ssr: true,
      webvisor: true,
      clickmap: true,
      accurateTrackBounce: true,
      trackLinks: true
    });
    window.__ymInitUrl = location.href;
  }

  function bootTag() {
    if (window.__ymPortfolioTag) return;
    window.__ymPortfolioTag = true;

    (function (m, e, t, r, i, k, a) {
      m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
      if (!m[i].l) m[i].l = 1 * new Date();
      for (var j = 0; j < document.scripts.length; j++) {
        if (document.scripts[j].src === r) return;
      }
      k = e.createElement(t);
      a = e.getElementsByTagName(t)[0];
      k.async = 1;
      k.src = r;
      a.parentNode.insertBefore(k, a);
    })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
  }

  function schedule() {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(bootTag, { timeout: 4000 });
    } else {
      setTimeout(bootTag, 1800);
    }
  }

  if (document.readyState === 'complete') schedule();
  else window.addEventListener('load', schedule, { once: true });
})();
`} />
      <noscript>
        <div>
          <img src={pixelSrc} style="position:absolute; left:-9999px;" alt="" width="1" height="1" />
        </div>
      </noscript>
    </div>
  ) : null
}
