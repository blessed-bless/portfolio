---
import { telegramChannel } from '../data/home';
import { defaultLocale, isLocale, localizedPath, ui, type Locale } from '../i18n';

const year = new Date().getFullYear();
const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
---

<footer class="site-footer page-pad" data-site-footer>
  <div class="site-footer__inner">
    <div class="site-footer__start">
      <p class="site-footer__name">{t.brand}</p>
      <a class="site-footer__link mono" href={localizedPath(locale, '/uses/')} data-cursor="hover">
        {t.footer.uses}
      </a>
      <a
        class="site-footer__link mono"
        href={telegramChannel.href}
        target="_blank"
        rel="noopener noreferrer"
        data-cursor="hover"
        data-tg-channel
      >
        {t.footer.channel}
      </a>
      <a class="site-footer__link mono" href={localizedPath(locale, '/privacy/')} data-cursor="hover">
        {t.footer.privacy}
      </a>
      <button
        type="button"
        class="site-footer__motion mono"
        data-less-motion
        data-cursor="hover"
        aria-pressed="false"
      >
        {t.footer.lessMotion}
      </button>
    </div>
    <p class="site-footer__year mono">{year}</p>
    <a class="site-footer__top mono" href="#main" data-cursor="hover">{t.footer.top}</a>
  </div>
</footer>

<script>
  import { isLessMotionToggleOn, toggleLessMotion } from '../scripts/perf';

  function syncLessMotionButtons(): void {
    const on = isLessMotionToggleOn();
    const lang = document.documentElement.lang === 'en' ? 'en' : 'ru';
    const labelOff = lang === 'en' ? 'Fewer animations' : 'Меньше анимаций';
    const labelOn = lang === 'en' ? 'Animations reduced' : 'Анимации урезаны';
    document.querySelectorAll<HTMLButtonElement>('[data-less-motion]').forEach((btn) => {
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      btn.textContent = on ? labelOn : labelOff;
    });
  }

  function bindLessMotion(): void {
    document.querySelectorAll<HTMLButtonElement>('[data-less-motion]').forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        toggleLessMotion();
        syncLessMotionButtons();
      });
    });
    syncLessMotionButtons();
  }

  bindLessMotion();
  document.addEventListener('astro:page-load', bindLessMotion);
  window.addEventListener('portfolio:less-motion', syncLessMotionButtons);
</script>

<style>
  .site-footer {
    border-top: var(--stroke) solid var(--border);
    padding-block: var(--space-5) var(--space-7);
  }

  .site-footer__inner {
    width: min(100%, var(--grid-max));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-4);
    align-items: center;
    font-size: var(--text-xs);
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
  }

  .site-footer__start {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
    flex-wrap: wrap;
  }

  .site-footer__name,
  .site-footer__year {
    margin: 0;
  }

  .site-footer__year {
    justify-self: center;
    color: var(--fg);
  }

  .site-footer__link,
  .site-footer__top,
  .site-footer__motion {
    text-decoration: none;
    color: var(--fg-muted);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .site-footer__motion {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  .site-footer__motion[aria-pressed='true'] {
    color: var(--accent-strong);
  }

  .site-footer__top {
    justify-self: end;
  }

  .site-footer__link:hover,
  .site-footer__top:hover,
  .site-footer__motion:hover {
    color: var(--accent-strong);
  }

  @media (max-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: var(--space-2);
    }

    .site-footer__year,
    .site-footer__top {
      justify-self: start;
    }
  }
</style>
