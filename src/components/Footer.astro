---
const year = new Date().getFullYear();
---

<footer class="site-footer page-pad" data-site-footer>
  <div class="site-footer__inner">
    <p class="site-footer__name">Богдан</p>
    <p class="site-footer__year mono">{year}</p>
    <a class="site-footer__top mono" href="#main" data-cursor="hover">Наверх</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--stroke) solid var(--border);
    padding-block: var(--space-5) var(--space-7);
  }

  .site-footer__inner {
    width: min(100%, var(--grid-max));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-4);
    align-items: center;
    font-size: var(--text-xs);
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
  }

  .site-footer__name,
  .site-footer__year {
    margin: 0;
  }

  .site-footer__year {
    justify-self: center;
    color: var(--fg);
  }

  .site-footer__top {
    justify-self: end;
    text-decoration: none;
    color: var(--fg-muted);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .site-footer__top:hover {
    color: var(--accent-strong);
  }

  @media (max-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: var(--space-2);
    }

    .site-footer__year,
    .site-footer__top {
      justify-self: start;
    }
  }
</style>
