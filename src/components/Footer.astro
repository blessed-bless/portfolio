---
import BrandMark from './BrandMark.astro';
import { telegramChannel } from '../data/home';
import { defaultLocale, isLocale, localizedPath, ui, type Locale } from '../i18n';

const year = new Date().getFullYear();
const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
const credit = t.footer.credit.replace('{year}', String(year));
---

<footer class="site-footer page-pad" data-site-footer>
  <p class="site-footer__wordmark" data-wordmark aria-hidden="true">
    <span class="site-footer__wordmark-inner" data-wordmark-inner>{t.brand}</span>
  </p>
  <div class="site-footer__inner">
    <p class="site-footer__credit">
      <BrandMark class="site-footer__mark" size={16} />
      <span>{credit}</span>
    </p>

    <nav class="site-footer__nav" aria-label={locale === 'en' ? 'Footer' : 'Подвал'}>
      <a class="site-footer__link" href={localizedPath(locale, '/uses/')} data-cursor="hover">
        {t.footer.uses}
      </a>
      <span class="site-footer__sep" aria-hidden="true">·</span>
      <a
        class="site-footer__link"
        href={telegramChannel.href}
        target="_blank"
        rel="noopener noreferrer"
        data-cursor="hover"
        data-tg-channel
      >
        {t.footer.channel}
      </a>
    </nav>

    <a class="site-footer__top" href="#main" data-cursor="hover">
      <span class="site-footer__top-label">{t.footer.top}</span>
      <span class="site-footer__top-icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
          <path
            d="M8 12.25V3.75M8 3.75 4.25 7.5M8 3.75 11.75 7.5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </a>

    <a class="site-footer__privacy" href={localizedPath(locale, '/privacy/')} data-cursor="hover">
      {t.footer.privacy}
    </a>

    <button
      type="button"
      class="site-footer__motion"
      data-less-motion
      data-cursor="hover"
      aria-pressed="false"
      data-label-off={t.footer.lessMotion}
      data-label-on={t.footer.lessMotionOn}
    >
      <span class="site-footer__motion-track" aria-hidden="true">
        <span class="site-footer__motion-knob"></span>
      </span>
      <span class="site-footer__motion-label" data-less-motion-label>{t.footer.lessMotion}</span>
    </button>
  </div>
</footer>

<script>
  import { isLessMotionToggleOn, toggleLessMotion } from '../scripts/perf';

  function syncLessMotionButtons(): void {
    const on = isLessMotionToggleOn();
    document.querySelectorAll<HTMLButtonElement>('[data-less-motion]').forEach((btn) => {
      const labelOff = btn.dataset.labelOff || 'Меньше анимаций';
      const labelOn = btn.dataset.labelOn || 'Анимации урезаны';
      const label = on ? labelOn : labelOff;
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      const text = btn.querySelector('[data-less-motion-label]');
      if (text) text.textContent = label;
    });
  }

  function bindLessMotion(): void {
    document.querySelectorAll<HTMLButtonElement>('[data-less-motion]').forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        toggleLessMotion();
        syncLessMotionButtons();
      });
    });
    syncLessMotionButtons();
  }

  bindLessMotion();
  document.addEventListener('astro:page-load', bindLessMotion);
  window.addEventListener('portfolio:less-motion', syncLessMotionButtons);
</script>

<style>
  .site-footer {
    border-top: var(--stroke) solid var(--border);
    padding-block: var(--space-5) var(--space-7);
  }

  .site-footer__wordmark {
    width: min(100%, var(--grid-max));
    margin: 0 auto var(--space-5);
    overflow: hidden;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.4rem, 1.2rem + 9vw, 8.5rem);
    line-height: 0.86;
    letter-spacing: var(--tracking-display);
    color: var(--fg);
  }

  .site-footer__wordmark-inner {
    display: block;
  }

  :global(html[data-perf='high']) .site-footer__wordmark-inner,
  :global(html[data-perf='mid']) .site-footer__wordmark-inner {
    transform: translate3d(0, 110%, 0);
  }

  :global(html[data-perf='high']) .site-footer__wordmark.is-in .site-footer__wordmark-inner,
  :global(html[data-perf='mid']) .site-footer__wordmark.is-in .site-footer__wordmark-inner {
    transform: translate3d(0, 0, 0);
    transition: transform 0.9s var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__wordmark-inner {
      transform: none !important;
    }
  }

  .site-footer__inner {
    width: min(100%, var(--grid-max));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas:
      'credit nav top'
      'privacy . motion';
    column-gap: var(--space-4);
    row-gap: var(--space-3);
    align-items: baseline;
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .site-footer__credit {
    grid-area: credit;
    margin: 0;
    min-width: 0;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .site-footer__mark {
    display: block;
    width: 16px;
    height: 16px;
    flex: none;
    color: var(--fg-muted);
  }

  .site-footer__nav {
    grid-area: nav;
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-2);
    white-space: nowrap;
  }

  .site-footer__sep {
    color: var(--fg-faint, var(--fg-muted));
    user-select: none;
  }

  .site-footer__top {
    grid-area: top;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    text-decoration: none;
    color: var(--fg-muted);
    white-space: nowrap;
  }

  .site-footer__top-icon {
    width: 1.7rem;
    height: 1.7rem;
    border: var(--stroke) solid var(--border-strong);
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .site-footer__privacy {
    grid-area: privacy;
    width: auto;
    max-width: max-content;
    justify-self: start;
    min-height: 44px;
    display: inline-flex;
    align-items: baseline;
    text-decoration: none;
    color: color-mix(in srgb, var(--fg-muted) 82%, transparent);
    font-size: 0.72rem;
    letter-spacing: normal;
    text-transform: none;
    white-space: nowrap;
  }

  .site-footer__link {
    text-decoration: none;
    color: inherit;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    letter-spacing: normal;
    text-transform: none;
  }

  .site-footer__motion {
    grid-area: motion;
    justify-self: end;
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font: inherit;
    font-size: 0.72rem;
    color: color-mix(in srgb, var(--fg-muted) 82%, transparent);
    letter-spacing: normal;
    text-transform: none;
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    min-height: 44px;
    white-space: nowrap;
  }

  .site-footer__motion-track {
    position: relative;
    width: 2.1rem;
    height: 1.15rem;
    border: var(--stroke) solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-soft);
    flex: none;
  }

  .site-footer__motion-knob {
    position: absolute;
    top: 50%;
    left: 0.14rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--fg-muted);
    transform: translateY(-50%);
    transition:
      left var(--dur-2) var(--ease-out),
      background var(--dur-2) var(--ease-out);
  }

  .site-footer__motion[aria-pressed='true'] {
    color: var(--accent-strong);
  }

  .site-footer__motion[aria-pressed='true'] .site-footer__motion-knob {
    left: calc(100% - 0.84rem);
    background: var(--accent);
  }

  .site-footer__link:hover,
  .site-footer__privacy:hover,
  .site-footer__top:hover,
  .site-footer__motion:hover {
    color: var(--accent-strong);
  }

  @media (max-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        'credit'
        'nav'
        'privacy'
        'motion'
        'top';
      justify-items: start;
      row-gap: var(--space-1);
    }

    .site-footer__top {
      justify-self: end;
      margin-top: var(--space-2);
    }

    .site-footer__motion {
      justify-self: start;
    }
  }
</style>
