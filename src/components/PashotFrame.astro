---
import { defaultLocale, isLocale, localizedPath, ui, type Locale } from '../i18n';
import menu from '../assets/screenshots/pashot-state-menu.webp';
import filter from '../assets/screenshots/pashot-state-filter.webp';
import gallery from '../assets/screenshots/pashot-state-gallery.webp';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
const frames = [
  { id: 'menu', label: t.home.pashotMenu, src: menu, alt: t.home.pashotAltMenu, eager: true },
  { id: 'filter', label: t.home.pashotFilter, src: filter, alt: t.home.pashotAltFilter, eager: false },
  { id: 'gallery', label: t.home.pashotGallery, src: gallery, alt: t.home.pashotAltGallery, eager: false },
];
---

<div class="pashot" data-pashot-frame>
  <div class="pashot__tabs" role="tablist" aria-label={t.home.pashotTabs}>
    {
      frames.map((frame, index) => (
        <button
          type="button"
          class="pashot__tab"
          role="tab"
          id={`pashot-tab-${frame.id}`}
          aria-controls={`pashot-panel-${frame.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-pashot-tab={frame.id}
        >
          {frame.label}
        </button>
      ))
    }
  </div>
  <div class="pashot__stage" data-pashot-stage>
    <div class="pashot__plane" data-pashot-plane>
      {
        frames.map((frame, index) => (
          <div
            class="pashot__panel"
            role="tabpanel"
            id={`pashot-panel-${frame.id}`}
            aria-labelledby={`pashot-tab-${frame.id}`}
            data-pashot-panel={frame.id}
            data-active={index === 0 ? 'true' : 'false'}
            inert={index === 0 ? undefined : true}
          >
            <img
              src={frame.src.src}
              width={frame.src.width}
              height={frame.src.height}
              alt={frame.alt}
              loading={frame.eager ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={frame.eager ? 'high' : undefined}
            />
          </div>
        ))
      }
    </div>
  </div>
  <p class="pashot__links">
    <a href={localizedPath(locale, '/work/pashot/')}>{t.home.pashotCase}</a>
    <a href="/demo/pashot/">{t.home.pashotDemo}</a>
  </p>
</div>

<script>
  import { getPerfTier, isLessMotionPreferred } from '../scripts/perf';

  const tabs = ['menu', 'filter', 'gallery'] as const;

  function reduced(): boolean {
    return isLessMotionPreferred() || window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function canReveal(): boolean {
    return getPerfTier() === 'high' && !reduced();
  }

  function bind(root: HTMLElement): void {
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-pashot-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-pashot-panel]')];
    const plane = root.querySelector<HTMLElement>('[data-pashot-stage]');

    const select = (id: string): void => {
      buttons.forEach((button) => {
        const on = button.dataset.pashotTab === id;
        button.setAttribute('aria-selected', String(on));
        button.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel) => {
        const on = panel.dataset.pashotPanel === id;
        panel.dataset.active = String(on);
        if (on) panel.removeAttribute('inert');
        else panel.setAttribute('inert', '');
      });
    };

    const move = (from: number, delta: number): void => {
      const next = (from + delta + tabs.length) % tabs.length;
      const id = tabs[next];
      if (!id) return;
      select(id);
      buttons[next]?.focus();
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => select(button.dataset.pashotTab || 'menu'));
      button.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          move(index, 1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          move(index, -1);
        } else if (event.key === 'Home') {
          event.preventDefault();
          select(tabs[0]);
          buttons[0]?.focus();
        } else if (event.key === 'End') {
          event.preventDefault();
          select(tabs[tabs.length - 1]);
          buttons[buttons.length - 1]?.focus();
        }
      });
    });

    let reveal: { kill: () => void } | null = null;
    const finish = (): void => {
      reveal?.kill();
      reveal = null;
      if (!plane) return;
      plane.style.opacity = '';
      plane.style.transform = '';
    };

    const arm = async (): Promise<void> => {
      finish();
      if (!plane || !canReveal()) return;
      const gsap = (await import('gsap')).default;
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(ScrollTrigger);
      if (!root.isConnected || !canReveal()) return;
      gsap.set(plane, { opacity: 0, rotateX: 16, y: 24, transformPerspective: 900 });
      const tween = gsap.to(plane, {
        opacity: 1,
        rotateX: 0,
        y: 0,
        duration: 0.85,
        ease: 'power3.out',
        scrollTrigger: { trigger: root, start: 'top 90%', once: true },
        onComplete: () => {
          gsap.set(plane, { clearProps: 'transform,opacity' });
        },
      });
      reveal = {
        kill: () => {
          tween.scrollTrigger?.kill();
          tween.kill();
          gsap.set(plane, { clearProps: 'transform,opacity' });
        },
      };
    };

    const onGate = (): void => {
      if (!canReveal()) finish();
    };
    window.addEventListener('portfolio:perf', onGate);
    window.addEventListener('portfolio:less-motion', onGate);
    void arm();
  }

  function start(): void {
    document.querySelectorAll<HTMLElement>('[data-pashot-frame]').forEach(bind);
  }
  start();
  document.addEventListener('astro:page-load', start);
</script>

<style>
  .pashot {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  .pashot__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pashot__tab {
    min-height: 44px;
    padding: 0.35rem 0.9rem;
    border: var(--stroke) solid var(--border-strong);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }

  .pashot__tab[aria-selected='true'] {
    color: var(--fg);
    border-color: var(--accent);
    background: #2a2a2e;
  }

  .pashot__stage {
    background: #2a2a2e;
    border: var(--stroke) solid var(--border-strong);
    aspect-ratio: 1120 / 723;
    min-height: 0;
    overflow: hidden;
  }

  .pashot__plane {
    position: relative;
    width: 100%;
    height: 100%;
    transform-origin: center bottom;
  }

  .pashot__panel {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 280ms ease;
  }

  .pashot__panel[data-active='true'] {
    opacity: 1;
    z-index: 1;
  }

  .pashot__panel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pashot__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
  }

  .pashot__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-strong);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .pashot__panel {
      transition: none;
    }
  }
</style>
