---
import { serviceOffers } from '../data/order';
import Button from './Button.astro';
import { defaultLocale, isLocale, localizedPath, ui, type Locale } from '../i18n';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
const offers = serviceOffers(locale);
---

<section class="offers page-pad" id="services" data-offers data-band="violet" aria-label={t.home.offersTitle}>
  <div class="offers__intro">
    <p class="eyebrow">{t.home.offersEyebrow}</p>
    <h2 class="offers__title" data-scramble>{t.home.offersTitle}</h2>
  </div>

  <div class="offers__list">
    {
      offers.map((offer) => (
        <article class="offer-row">
          <h3 class="offer-row__title">
            <a href={localizedPath(locale, `/work/${offer.caseSlug}/`)}>{offer.title}</a>
          </h3>
          <p class="offer-row__text">{offer.description}</p>
          <p class="offers__estimate">
            <strong>{offer.priceLabel}</strong>
            <span>{offer.timing}</span>
          </p>
        </article>
      ))
    }
  </div>
  <div class="offers__card-links">
    <Button href={localizedPath(locale, '/order/')} variant="primary">{t.nav.order}</Button>
  </div>
</section>

<style>
  .offers {
    padding-block: var(--section-gap);
    border-top: var(--stroke) solid var(--border);
  }

  .offers__intro {
    margin-bottom: var(--space-6);
    max-width: 42rem;
  }

  .offers__title {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .offers__list {
    border-bottom: var(--stroke) solid var(--border);
  }

  .offer-row {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr) auto;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: 1.15rem;
    border-top: var(--stroke) solid var(--border);
  }

  .offer-row__title {
    margin: 0;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.8rem);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .offer-row__title a {
    color: inherit;
    text-decoration: none;
  }

  .offer-row__title a:hover,
  .offer-row__title a:focus-visible {
    color: var(--accent-strong);
  }

  .offer-row__text {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .offers__estimate {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-3);
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .offers__estimate strong {
    color: var(--accent-strong);
    font-size: var(--text-md);
  }

  .offers__card-links {
    margin: var(--space-5) 0 0;
  }

  @media (max-width: 900px) {
    .offer-row {
      grid-template-columns: 1fr;
    }

    .offers__estimate {
      justify-content: flex-start;
    }
  }
</style>
