---
import { serviceOffers } from '../data/order';
import Button from './Button.astro';
import { isFilled } from '../lib/fill';
import { defaultLocale, isLocale, localizedPath, ui, type Locale } from '../i18n';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
const offers = serviceOffers(locale);
const processSteps = t.process;
const showTiming = processSteps.some((step) => isFilled(step.timing));
---

<section class="offers page-pad" id="services" data-offers data-band="violet" aria-label={t.home.offersTitle}>
  <div class="offers__intro">
    <p class="eyebrow">{t.home.offersEyebrow}</p>
    <h2 class="offers__title" data-scramble>{t.home.offersTitle}</h2>
  </div>

  <div class="offers__list">
    {
      offers.map((offer) => (
        <article class="offer-row">
          <h3 class="offer-row__title">
            <a href={localizedPath(locale, `/work/${offer.caseSlug}/`)}>{offer.title}</a>
          </h3>
          <p class="offer-row__text">{offer.description}</p>
          <p class="offers__estimate">
            <strong>{offer.priceLabel}</strong>
            <span>{offer.timing}</span>
          </p>
        </article>
      ))
    }
    <article class="offer-row">
      <h3 class="offer-row__title">
        <a href={localizedPath(locale, '/work/shipcrew/')}>{t.home.agentTitle}</a>
      </h3>
      <p class="offer-row__text">{t.home.agentOutcome}</p>
    </article>
  </div>
  <div class="offers__card-links">
    <Button href={localizedPath(locale, '/order/')} variant="primary">{t.nav.order}</Button>
  </div>
</section>

<section class="process page-pad" data-process data-band="ink" aria-label={t.home.processTitle}>
  <div class="process__pin" data-process-pin>
    <div class="process__intro">
      <p class="eyebrow">{t.home.processEyebrow}</p>
      <h2 class="process__title" data-scramble>{t.home.processTitle}</h2>
    </div>
    <ol class="process__list">
      {
        processSteps.map((step, index) => (
          <li class="process__step" data-process-step>
            <p class="process__num mono">{String(index + 1).padStart(2, '0')}</p>
            <h3 class="process__step-title">{step.title}</h3>
            <p class="process__step-text">{step.text}</p>
            {showTiming && isFilled(step.timing) ? (
              <p class="process__timing mono">{step.timing}</p>
            ) : null}
          </li>
        ))
      }
    </ol>
    <div class="process__meter" aria-hidden="true">
      <span data-process-bar></span>
    </div>
  </div>
</section>

<style>
  .offers,
  .process {
    padding-block: var(--section-gap);
    border-top: var(--stroke) solid var(--border);
  }

  .offers__intro,
  .process__intro {
    margin-bottom: var(--space-6);
    max-width: 42rem;
  }

  .offers__title,
  .process__title {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .offers__list {
    border-bottom: var(--stroke) solid var(--border);
  }

  .offer-row {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr) auto;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: 1.15rem;
    border-top: var(--stroke) solid var(--border);
  }

  .offer-row__title {
    margin: 0;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.8rem);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .offer-row__title a {
    color: inherit;
    text-decoration: none;
  }

  .offer-row__title a:hover,
  .offer-row__title a:focus-visible {
    color: var(--accent-strong);
  }

  .offer-row__text {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .offers__estimate {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-3);
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .offers__estimate strong {
    color: var(--accent-strong);
    font-size: var(--text-md);
  }

  .offers__card-links {
    margin: var(--space-5) 0 0;
  }

  .process__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .process__step {
    min-width: 0;
    padding-top: var(--space-4);
    border-top: var(--stroke) solid var(--border-strong);
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .process[data-active='true'] .process__step {
    opacity: 0.55;
  }

  .process[data-active='true'] .process__step[data-current='true'] {
    opacity: 1;
  }

  .process__num {
    margin: 0;
    color: var(--accent-strong);
    font-size: var(--text-sm);
  }

  .process__step-title {
    margin: 0;
    font-size: var(--text-md);
    font-weight: 650;
  }

  .process__step-text {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .process__timing {
    margin: var(--space-2) 0 0;
    color: var(--fg);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .process__meter {
    height: 2px;
    margin-top: var(--space-5);
    background: var(--border);
  }

  .process__meter span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0.04);
    transform-origin: left center;
  }

  @media (max-width: 900px) {
    .offer-row,
    .process__list {
      grid-template-columns: 1fr;
    }

    .offers__estimate {
      justify-content: flex-start;
    }

    .process__step {
      opacity: 1;
    }
  }
</style>
