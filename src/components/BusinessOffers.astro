---
import { serviceOffers } from '../data/order';
import Button from './Button.astro';
import { isFilled } from '../lib/fill';
import { defaultLocale, isLocale, localizedPath, ui, type Locale } from '../i18n';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
const offers = serviceOffers(locale);
const processSteps = t.process;
const showTiming = processSteps.some((step) => isFilled(step.timing));
---

<section class="offers page-pad" id="services" data-offers aria-label={t.home.offersTitle}>
  <div class="offers__intro">
    <p class="eyebrow">{t.home.offersEyebrow}</p>
    <h2 class="offers__title" data-scramble>{t.home.offersTitle}</h2>
  </div>

  <div class="offers__grid">
    {
      offers.map((offer) => (
        <article class="offers__card">
          <h3 class="offers__card-title">{offer.title}</h3>
          <p class="offers__card-text">{offer.description}</p>
          <p class="offers__estimate">
            <strong>{offer.priceLabel}</strong>
            <span>{offer.timing}</span>
          </p>
        </article>
      ))
    }
  </div>
  <div class="offers__card-links">
    <Button href={localizedPath(locale, '/order/')} variant="primary">{t.nav.order}</Button>
  </div>
</section>

<section class="process page-pad" data-process aria-label={t.home.processTitle}>
  <div class="process__intro">
    <p class="eyebrow">{t.home.processEyebrow}</p>
    <h2 class="process__title" data-scramble>{t.home.processTitle}</h2>
  </div>

  <ol class="process__list">
    {
      processSteps.map((step, index) => (
        <li class="process__step">
          <p class="process__num mono">{String(index + 1).padStart(2, '0')}</p>
          <h3 class="process__step-title">{step.title}</h3>
          <p class="process__step-text">{step.text}</p>
          {showTiming && isFilled(step.timing) ? (
            <p class="process__timing mono">{step.timing}</p>
          ) : null}
        </li>
      ))
    }
  </ol>

</section>

<style>
  .offers,
  .process {
    padding-block: var(--section-gap);
    border-top: var(--stroke) solid var(--border);
  }

  .offers__intro,
  .process__intro {
    margin-bottom: var(--space-6);
    max-width: 42rem;
  }

  .offers__title,
  .process__title {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }


  .offers__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .offers__card {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-5);
    border: var(--stroke) solid var(--border);
    background: var(--bg-elevated);
    color: inherit;
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .offers__card:hover {
    border-color: var(--border-strong);
  }


  .offers__card-title {
    margin: 0;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.65rem);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .offers__card-text {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .offers__estimate {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .offers__estimate strong {
    color: var(--accent-strong);
    font-size: var(--text-md);
  }

  .offers__card-links {
    margin: var(--space-5) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }



  .process__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .process__step {
    min-width: 0;
    padding-top: var(--space-4);
    border-top: var(--stroke) solid var(--border-strong);
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .process__num {
    margin: 0;
    color: var(--accent-strong);
    font-size: var(--text-sm);
  }

  .process__step-title {
    margin: 0;
    font-size: var(--text-md);
    font-weight: 650;
  }

  .process__step-text {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .process__timing {
    margin: var(--space-2) 0 0;
    color: var(--fg);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }




  @media (max-width: 900px) {
    .offers__grid,
    .process__list {
      grid-template-columns: 1fr;
    }
  }
</style>
