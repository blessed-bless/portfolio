---
import { telegramChannel } from '../data/home';
import { fetchChannelPosts, formatChannelDate } from '../lib/telegram-channel';
import { ui } from '../i18n';

const t = ui('ru');
const posts = await fetchChannelPosts(3);
---

{
  posts.length > 0 ? (
    <section class="channel page-pad" data-channel aria-label={t.home.channelTitle}>
      <div class="channel__head">
        <p class="eyebrow">{t.home.channelEyebrow}</p>
        <h2 class="channel__title">{t.home.channelTitle}</h2>
      </div>

      <ul class="channel__list">
        {posts.map((post) => (
          <li>
            <a
              class="channel__row"
              href={post.href}
              target="_blank"
              rel="noopener noreferrer"
              data-cursor="hover"
              data-tg-channel
            >
              <time class="channel__date mono" datetime={post.date}>
                {formatChannelDate(post.date, 'ru')}
              </time>
              <span class="channel__text">{post.text}</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="channel__more">
        <a
          class="mono"
          href={telegramChannel.href}
          target="_blank"
          rel="noopener noreferrer"
          data-cursor="hover"
          data-tg-channel
        >
          {t.home.channelMore} →
        </a>
      </p>
    </section>
  ) : null
}

<style>
  .channel {
    padding-block: var(--section-gap);
    border-top: var(--stroke) solid var(--border);
  }

  .channel__head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .channel__title {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .channel__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--stroke) solid var(--border);
    max-width: 42rem;
  }

  .channel__row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    padding-block: clamp(1rem, 2vw, 1.5rem);
    border-bottom: var(--stroke) solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: color var(--dur-2) var(--ease-out);
  }

  .channel__row:hover,
  .channel__row:focus-visible {
    color: var(--accent-strong);
  }

  .channel__date {
    color: var(--fg-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .channel__text {
    font-size: var(--text-md);
    line-height: var(--leading-body);
  }

  .channel__more {
    margin: var(--space-5) 0 0;
  }

  .channel__more a {
    color: var(--fg-muted);
    text-decoration: none;
  }

  .channel__more a:hover,
  .channel__more a:focus-visible {
    color: var(--accent-strong);
  }

  @media (max-width: 560px) {
    .channel__row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
