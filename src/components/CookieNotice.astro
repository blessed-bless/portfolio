---
import { defaultLocale, isLocale, localizedPath, ui, type Locale } from '../i18n';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = ui(locale);
const privacyHref = localizedPath(locale, '/privacy/');
---

<div class="cookie-banner" data-cookie-banner hidden role="region" aria-label={t.cookie.settings}>
  <p class="cookie-banner__text">
    {t.cookie.text}{' '}
    <a class="cookie-banner__link" href={privacyHref} data-cursor="hover">{t.cookie.more}</a>
  </p>
  <div class="cookie-banner__actions">
    <button type="button" class="cookie-banner__choice" data-cookie-decline>{t.cookie.reject}</button>
    <button type="button" class="cookie-banner__choice" data-cookie-allow>{t.cookie.ok}</button>
  </div>
</div>

<style is:global>
  /* Space token for FABs only — banner is position:fixed, so no shell padding (CLS). */
  html[data-show-cookie='1'] {
    --cookie-notice-space: calc(9rem + env(safe-area-inset-bottom, 0px));
  }
</style>

<style>
  .cookie-banner {
    position: fixed;
    z-index: 40;
    left: var(--page-pad);
    right: auto;
    bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
    top: auto;
    width: min(calc(100% - (var(--page-pad) * 2)), 28rem);
    height: auto;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: var(--stroke) solid var(--border-strong);
    background: color-mix(in srgb, var(--bg-elevated) 94%, transparent);
    color: var(--fg);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    pointer-events: auto;
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner__text {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    color: var(--fg-muted);
  }

  .cookie-banner__link {
    color: var(--fg);
    text-underline-offset: 0.18em;
  }

  .cookie-banner__link:hover {
    color: var(--accent-strong);
  }

  .cookie-banner__choice {
    flex: 0 0 auto;
    appearance: none;
    border: var(--stroke) solid var(--border-strong);
    background: transparent;
    color: var(--fg);
    min-height: 44px;
    padding: 0.45rem 0.9rem;
    font: inherit;
    font-weight: 600;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .cookie-banner__choice:hover {
    border-color: var(--fg);
  }

  .cookie-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 520px) {
    .cookie-banner {
      right: var(--page-pad);
      width: auto;
    }
  }
</style>
